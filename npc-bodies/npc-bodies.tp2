									LPF REPLACE_MULTILINE
											INT_VAR
											strict = 1
											verbose = 0
											STR_VAR
											pattern = EVAL ~~~~~IF
    InPartyAllowDead("%dv%")
    Global("EJdead%ind%","GLOBAL",1)
    PartyHasItem("EJB%ind%a")
THEN
    RESPONSE #100
        ChangeGeneral("%dv%",DEAD)
END~~~~~  //pattern that you want to replace
											string = EVAL ~~~~~IF
    InPartyAllowDead("%dv%")
    Global("EJdead%ind%","GLOBAL",1)
    PartyHasItem("EJB%ind%a")
	GlobalTimerExpired("EJREV%ind%","GLOBAL")
THEN
