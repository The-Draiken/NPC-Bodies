		ACTION_IF (~%script%~ STRING_EQUAL_CASE ~none~) BEGIN
			OUTER_SET skip = 1
		END	
		ACTION_IF (~%script%~ STRING_EQUAL_CASE ~~) BEGIN
			OUTER_SET skip = 1
		END
		// Skip undead (race 125) - vampires and other undead don't drop bodies
		ACTION_IF (race = 125) BEGIN
			OUTER_SET skip = 1
		END
		COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
			COUNT_2DA_COLS cols
			READ_2DA_ENTRIES_NOW ~r2en_bods~ cols
			FOR (row = 0; row < r2en_bods; ++row) BEGIN
				READ_2DA_ENTRY_FORMER ~r2en_bods~ row 0 prev_ind
				READ_2DA_ENTRY_FORMER ~r2en_bods~ row 1 prev_dv
				READ_2DA_ENTRY_FORMER ~r2en_bods~ row 4 prev_script
				READ_2DA_ENTRY_FORMER ~r2en_bods~ row 7 prev_weight
				PATCH_IF (skip = 0) BEGIN
					PATCH_IF (~%dv%~ STRING_EQUAL_CASE ~%prev_dv%~) BEGIN
						SET ind = prev_ind
						SET weight = prev_weight					
						PATCH_IF (~%script%~ STRING_EQUAL_CASE ~%prev_script%~) BEGIN
							SET skip = 1
						END	
					END
				END
			END
			
		ACTION_IF (ind = 0) BEGIN
				OUTER_SET ind = bind
				OUTER_SET bind += 1	
		END
			
		ACTION_IF (skip = 0)	BEGIN
			APPEND_OUTER ~weidu_external/npc-bodies/NPCbods.2da~ ~%ind% %dv%	%cre%	%name%	%script%	%race%	%gender% %weight% %general%~
		END
	END
END */
/*COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
		COUNT_2DA_COLS cols
		READ_2DA_ENTRIES_NOW ~r2en_bods~ cols
		FOR (row = 0; row < r2en_bods; ++row) BEGIN
			READ_2DA_ENTRY_FORMER ~r2en_bods~ row 0 ind
			READ_2DA_ENTRY_FORMER ~r2en_bods~ row 1 dv
			READ_2DA_ENTRY_FORMER ~r2en_bods~ row 3 name
			READ_2DA_ENTRY_FORMER ~r2en_bods~ row 4 script
			INNER_ACTION BEGIN */
//Need to have a way to set another timer, do all dead npcs in party-- spell summons invisible creature that sest a global for each NPC for revivify and another for the normal timing, when the timer ends for these spells instead of doing the normal effect these restart the timer set to 10 days. 		

// =============================================================================
// Component 600: Temple Resurrection of Fallen Companions
// =============================================================================
BEGIN @600 // Temple Resurrection of Fallen Companions
DESIGNATED 600
LABEL ~NPC_BODIES_TEMPLE_RESURRECTION~
REQUIRE_COMPONENT ~npc-bodies.tp2~ 100 ~Requires main component~
// Chunked/disintegrated companions are only rebuilt by Stratagems' "Revised
// handling of death effects" (4130), so this component installs only after it.
REQUIRE_COMPONENT ~stratagems/setup-stratagems.tp2~ 4130 ~Requires Stratagems component 4130 (Revised handling of death effects) to be installed first. If you also use Spell Revisions, see the Stratagems compatibility patch in the NPC Bodies README.~

// -----------------------------------------------------------------------------
// Dynamically detect temple/priest NPCs across the WHOLE installed game
// (base game + EET-merged BG1/SoD/BG2 + any other installed NPC/content mods)
// instead of a hardcoded 13-name resref list.
//
// Heuristic: any creature resource that (a) is single-classed Cleric per
// CLASS.IDS, (b) is not hostile (EA <= 30 on EA.IDS, i.e. not an enemy
// faction), and (c) has its own same-resref .DLG file (so it's a nameable,
// talkable NPC and not bare monster filler) is treated as a candidate
// temple priest and gets the "bring back a fallen companion" reply appended
// to its greeting state.
//
// This is a heuristic, not a certainty. It will likely miss Cleric/Ranger,
// Cleric/Mage, Cleric/Thief and Fighter/Cleric multiclass priests (they
// carry a different, combined CLASS.IDS value) and it may flag a background
// Cleric NPC that has no actual temple/store attached. Both are worth
// checking for in-game before treating this as final.
// -----------------------------------------------------------------------------
// Detected priests are stored as a small 2DA (one resref per row) instead of
// one big space-joined string. ACTION_FOR_EACH's IN clause does NOT split a
// %variable%-substituted string into separate items -- it was silently
// treating the whole multi-hundred-name blob as a single (useless) list
// entry, so the per-priest loop below never matched anything and no dialogue
// was ever generated even though the scan itself was working. Reusing the
// 2DA read/count pattern already used for NPCbods.2da elsewhere in this file
// avoids that problem entirely.
<<<<<<<< npc-inline/ejt_priests.2da
2DA V1.0
RESREF
0	#
>>>>>>>>
COPY ~npc-inline/ejt_priests.2da~ ~weidu_external/npc-bodies/ejt_priests.2da~
OUTER_SET ejt_priest_count = 0

// CLASSMSK.IDS does not exist as a real resource in this game (confirmed via
// install log: "Resource [CLASSMSK.IDS] not found"), so multiclass Clerics are
// matched directly against every Cleric-involving CLASS.IDS entry instead of a
// bitmask. Values below confirmed directly from this install's own class.ids.
OUTER_SET ejt_cleric_class = IDS_OF_SYMBOL (class CLERIC)
OUTER_SET ejt_fighter_cleric = IDS_OF_SYMBOL (class FIGHTER_CLERIC)
OUTER_SET ejt_cleric_mage = IDS_OF_SYMBOL (class CLERIC_MAGE)
OUTER_SET ejt_cleric_thief = IDS_OF_SYMBOL (class CLERIC_THIEF)
OUTER_SET ejt_fighter_mage_cleric = IDS_OF_SYMBOL (class FIGHTER_MAGE_CLERIC)
OUTER_SET ejt_cleric_ranger = IDS_OF_SYMBOL (class CLERIC_RANGER)
COPY_EXISTING_REGEXP ~.+\.cre~ ~override~
	READ_BYTE 0x270 ejt_ea
	READ_BYTE 0x273 ejt_class
	PATCH_IF (ejt_ea < 200) AND ((ejt_class = ejt_cleric_class) OR (ejt_class = ejt_fighter_cleric) OR (ejt_class = ejt_cleric_mage) OR (ejt_class = ejt_cleric_thief) OR (ejt_class = ejt_fighter_mage_cleric) OR (ejt_class = ejt_cleric_ranger)) BEGIN
		SPRINT ejt_cand_cre ~%SOURCE_RES%~
		INNER_ACTION BEGIN
			ACTION_IF FILE_EXISTS_IN_GAME ~%ejt_cand_cre%.dlg~ BEGIN
				OUTER_SET ejt_priest_count += 1
				APPEND_OUTER ~weidu_external/npc-bodies/ejt_priests.2da~ ~%ejt_priest_count%	%ejt_cand_cre%~
				// Mirrors JOINABLE_NPC_ARRAY in misc_functions.tpa: an associative
				// array keyed by resref, so the single-pass area scan below can do
				// an O(1) membership check instead of re-scanning the whole game
				// once per priest.
				ACTION_DEFINE_ASSOCIATIVE_ARRAY EJT_PRIEST_SET BEGIN ~%ejt_cand_cre%~ => ~~ END
			END
		END
	END
BUT_ONLY

// -----------------------------------------------------------------------------
// TEMPORARY DIAGNOSTIC -- writes what the detection scan found to a plain text
// file so we can see it without guessing. Safe to delete once Component 600 is
// confirmed working: it has no effect on gameplay, it just leaves a text file
// in weidu_external/npc-bodies/.
// -----------------------------------------------------------------------------
OUTER_SPRINT ejt_cleric_class_str ~%ejt_cleric_class%~
OUTER_SPRINT ejt_priest_count_str ~%ejt_priest_count%~
<<<<<<<< npc-inline/ejt_debug.txt
NPC Bodies Component 600 diagnostic dump
>>>>>>>>
COPY ~npc-inline/ejt_debug.txt~ ~weidu_external/npc-bodies/ejt_debug.txt~
APPEND_OUTER ~weidu_external/npc-bodies/ejt_debug.txt~ ~cleric_class_value=%ejt_cleric_class_str%~
APPEND_OUTER ~weidu_external/npc-bodies/ejt_debug.txt~ ~priest_count=%ejt_priest_count_str%~

// -----------------------------------------------------------------------------
// Determine each detected priest's home area, in ONE single pass over every
// area in the game (also keeping a full diagnostic dump of every placed
// actor along the way). This used to re-run a full .are rescan once PER
// DETECTED PRIEST (nested inside the priest loop) -- besides being extremely
// slow (hundreds of full-game rescans), it was directly confirmed to produce
// wrong results: a one-off single-pass version of this same scan correctly
// found KELDDA's real area, while the per-priest-repeated version kept
// reporting NONE for him using the identical read. Doing it once here, using
// the same associative-array cross-referencing already proven elsewhere in
// this codebase (JOINABLE_NPC_ARRAY in misc_functions.tpa, consumed via
// ACTION_PHP_EACH), fixes both the performance problem and the correctness
// problem at once. EJT_PRIEST_SET (built above, alongside ejt_priests.2da)
// gives an O(1) membership check per actor instead of a re-scan per priest.
// This is required in the first place because the actual relocation action
// -- MoveGlobal, confirmed via the Wild Mage Editions mod's own "Hornung's
// Random Dispatcher" implementation (wildmage/wild_spells/baf/wm_disp.baf)
// -- needs a literal, compile-time-known destination area string. There is
// no way to compute "wherever the player currently is" at runtime for this
// action; MoveBetweenAreas(Player1), tried earlier, does not work for
// exactly this reason (type mismatch: it wants a literal string, not an
// object).
// ARE header: Actors offset @ 0x54 (long), # actors @ 0x58 (short).
// Actor entry: 272 bytes each; CRE file resref @ +128 (8 bytes).
// -----------------------------------------------------------------------------
<<<<<<<< npc-inline/ejt_all_actors.txt
CRE	AREA	POS
>>>>>>>>
COPY ~npc-inline/ejt_all_actors.txt~ ~weidu_external/npc-bodies/ejt_all_actors.txt~
COPY_EXISTING_REGEXP ~.+\.are~ ~override~
	READ_LONG 0x54 ejt_actors_offset
	READ_SHORT 0x58 ejt_num_actors
	FOR (ejt_actor_i = 0; ejt_actor_i < ejt_num_actors; ++ejt_actor_i) BEGIN
		READ_ASCII (ejt_actors_offset + (ejt_actor_i * 272) + 128) ejt_actor_cre (8) NULL
		// Position: X @ +32, Y @ +34 (2 bytes each) -- confirmed via
		// NearInfinity's Actor.java (ARE_ACTOR_POS_X/ARE_ACTOR_POS_Y).
		// [1000.1000], copied from the Wild Mage Editions example, was never
		// actually verified as a walkable point for every area -- it's a
		// reasonable guess for a big outdoor map but likely invalid inside a
		// small temple interior. Using the priest's own real position instead
		// guarantees a valid, walkable destination, since he's standing there.
		READ_SHORT (ejt_actors_offset + (ejt_actor_i * 272) + 32) ejt_actor_x
		READ_SHORT (ejt_actors_offset + (ejt_actor_i * 272) + 34) ejt_actor_y
		SPRINT ejt_actor_cre_s ~%ejt_actor_cre%~
		SPRINT ejt_actor_area_s ~%SOURCE_RES%~
		SPRINT ejt_actor_pos_s ~%ejt_actor_x%.%ejt_actor_y%~
		INNER_ACTION BEGIN
			APPEND_OUTER ~weidu_external/npc-bodies/ejt_all_actors.txt~ ~%ejt_actor_cre_s%	%ejt_actor_area_s%	%ejt_actor_pos_s%~
		END
		PATCH_IF VARIABLE_IS_SET $EJT_PRIEST_SET(~%ejt_actor_cre%~) BEGIN
			PATCH_IF NOT VARIABLE_IS_SET $EJT_PRIEST_AREA(~%ejt_actor_cre%~) BEGIN
				// Value is the fully pre-formatted MoveGlobal argument list
				// (area, target object, and the priest's own real point) so
				// the generation loop below can drop it straight into
				// MoveGlobal(...) with a single placeholder.
				// NOTE ON THE MakeGlobal/MoveGlobal vs LeaveAreaLUA HISTORY:
				// per the Wild Mage Editions source (wm_disp.baf line 191:
				// "For party members, uses LeaveAreaLUA; for NPCs, uses
				// MoveGlobal with MakeGlobal"), MakeGlobal+MoveGlobal is the
				// CORRECT pair for an object the engine does not currently
				// track as party-affiliated -- which, under the redesigned
				// Component 600 flow (see ejtemple-single.d), is exactly
				// what this companion is at the moment of relocation: she is
				// revived by directly casting Raise Dead/Resurrection on her
				// BEFORE she ever rejoins the party, so JoinParty() only
				// ever runs on an ALIVE creature (the well-supported case
				// used everywhere else in the game). Switching to
				// LeaveAreaLUA earlier did not fix the crash (confirmed via
				// two symbolicated dumps with an identical failure
				// signature); disassembly of the actual GroupSetTarget call
				// site traced the null pointer to a per-party-member
				// formation record that's very plausibly only initialized
				// when JoinParty() runs on a living creature -- not to
				// which relocation call precedes it. Reverted to
				// MakeGlobal/MoveGlobal accordingly, now that it's being
				// used on a genuinely non-party object as intended.
				DEFINE_ASSOCIATIVE_ARRAY EJT_PRIEST_AREA BEGIN ~%ejt_actor_cre%~ => ~"%SOURCE_RES%",Myself,[%ejt_actor_x%.%ejt_actor_y%]~ END
			END
		END
	END
BUT_ONLY

// TEMPORARY DIAGNOSTIC -- plain-text dump of the final priest->MoveGlobal-args
// mapping built above, so it can be checked directly instead of guessed at.
// Safe to delete once Component 600 is confirmed fully working.
<<<<<<<< npc-inline/ejt_priest_areas.txt
PRIEST	MOVEGLOBAL_ARGS
>>>>>>>>
COPY ~npc-inline/ejt_priest_areas.txt~ ~weidu_external/npc-bodies/ejt_priest_areas.txt~
ACTION_PHP_EACH EJT_PRIEST_AREA AS ejt_dump_priest => ejt_dump_area BEGIN
	APPEND_OUTER ~weidu_external/npc-bodies/ejt_priest_areas.txt~ ~%ejt_dump_priest%	%ejt_dump_area%~
END

// -----------------------------------------------------------------------------
// Wish / genie: bring back a DISMISSED (out-of-party) dead companion for
// free, framed as convincing the genie Wish summons. Per the user's
// explicit design: Wish is meant to supersede Raise Dead/Resurrection
// entirely -- no gold cost, no CON penalty, no permanent-death exclusion --
// and per later user feedback, this needs to be RELIABLY reachable (for
// testing, and just generally), not gated behind rare random odds.
//
// REDESIGNED after live testing: the original version of this feature built
// a whole parallel creature (EJGENIE) + script + cloned spell (SPWISH41) +
// wish.2da roll-table entry from scratch. The user then pointed out (a) 11
// Wish casts never surfaced it (consistent with it never having actually
// been installed yet at the time -- but also with wish.2da odds simply
// being bad) and (b) it should just always be available rather than random.
// Investigating the user-supplied XPexchange mod's own tp2 revealed BG2:EE
// ALREADY ships two fully scripted "talk to a genie" creatures for Wish --
// WISH01.CRE and WISH02.CRE -- each with its own real dialogue (resref
// stored at CRE offset 0x2CC; confirmed via XPexchange's own
// COPY_EXISTING+READ_ASCII 0x2cc, and confirmed by direct inspection here
// that WISH01's and WISH02's dialogues are NOT the same resref, so both are
// read dynamically below rather than guessed/hardcoded). Extending those
// two real dialogues -- the exact same EXTEND_BOTTOM technique already
// used for temple priests -- is simpler and more authentic than the
// from-scratch approach, and an extra unconditional Summon Creature effect
// on Wish's own spell (WIZARD_WISH) guarantees a genie appears on every
// single cast, regardless of the normal random roll.
ACTION_IF FILE_EXISTS_IN_GAME ~WISH01.cre~ BEGIN
	// BUGFIX: a bare "RET ejt_wish_res" here failed to install with
	// "Unknown return value: ejt_wish_res". Every other call to
	// RES_NUM_OF_SPELL_NAME in this entire file (17 of them) uses bare
	// "RET spell_res" and none rename it -- that's apparently not a style
	// choice but a real constraint on this particular function/RET
	// mechanism. Rather than risk a second failed install guessing at
	// alias syntax, this just follows the same bare "RET spell_res"
	// convention as every other call site, then immediately copies the
	// result into our own variable before anything else that reuses
	// "spell_res" later can overwrite it.
	LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_WISH~ RET spell_res END
	OUTER_SPRINT ejt_wish_res ~%spell_res%~
	ACTION_IF FILE_EXISTS_IN_GAME ~%ejt_wish_res%.spl~ BEGIN
		COPY_EXISTING ~%ejt_wish_res%.spl~ ~override~
			// Values match this mod's other summon-a-helper effect
			// (previously used for the scrapped EJGENIE, itself copied from
			// Stratagems' proven dw#diamo pattern) -- WISH01 is used
			// completely unmodified here (not cloned), so its own already-
			// working vanilla script/dialogue-triggering behavior is
			// trusted to do the rest exactly as it always has.
			// BUGFIX: removed the extra opcode-67 summon of WISH01; vanilla Wish already summons the genie, so it produced two per cast.
		BUT_ONLY
	END

	// Read each genie's own dialogue resref dynamically (see comment above
	// on why this can't be hardcoded). Uses the same READ-then-SPRINT-then-
	// INNER_ACTION dance already used elsewhere in this file to move a
	// COPY_EXISTING-scoped value out to OUTER scope.
	COPY_EXISTING ~WISH01.cre~ ~override~
		READ_ASCII 0x2cc ejt_wishdlg1_r
		SPRINT ejt_wishdlg1_s ~%ejt_wishdlg1_r%~
		INNER_ACTION BEGIN
			OUTER_SPRINT ejt_wishdlg1_str ~%ejt_wishdlg1_s%~
		END
	BUT_ONLY

	OUTER_SET ejt_have_wishdlg2 = 0
	ACTION_IF FILE_EXISTS_IN_GAME ~WISH02.cre~ BEGIN
		COPY_EXISTING ~WISH02.cre~ ~override~
			READ_ASCII 0x2cc ejt_wishdlg2_r
			SPRINT ejt_wishdlg2_s ~%ejt_wishdlg2_r%~
			INNER_ACTION BEGIN
				OUTER_SPRINT ejt_wishdlg2_str ~%ejt_wishdlg2_s%~
			END
		BUT_ONLY
		// Only treat WISH02 as a second, separate target if its dialogue
		// resref actually differs from WISH01's -- no point extending the
		// same dialogue file twice.
		ACTION_IF NOT (~%ejt_wishdlg1_str%~ STRING_EQUAL_CASE ~%ejt_wishdlg2_str%~) BEGIN
			OUTER_SET ejt_have_wishdlg2 = 1
		END
	END
END

// Per-index D files, generated for every companion NPC Bodies has ever
// tracked a death for, matched against every detected priest above.
// No longer gated on the body item existing: a companion with no body at
// all must still be recoverable via the no-penalty Resurrection path (see
// ejtemple-single.d), so every row in NPCbods.2da gets a dialogue entry.
//
// NOTE ON SCALE: with the scan now matching hundreds of real priests across
// the whole EET world instead of 13 hardcoded ones, this generates and
// compiles one small .d file per (priest, companion) pair -- potentially
// tens of thousands of tiny compiles. That is expected to make this specific
// component take noticeably longer to install than before. If that turns out
// to be impractical, the next step is collapsing this to one .d file per
// priest (looping companions inside it) instead of one file per pair.
ACTION_IF FILE_EXISTS ~weidu_external/npc-bodies/NPCbods.2da~ BEGIN
	COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
		COUNT_2DA_ROWS 9 ejt_total_rows
	// BUGFIX (duplicate options): some companions appear under more than one
	// INDEX with the same display name (Jaheira: index 65 dv IDIOT01, and index
	// 67 dv JAHEIRA). Each index generated its own temple/genie reply, so the
	// player saw two "Resurrection" lines, one targeting the wrong script name
	// (did nothing). Pre-pass: record the highest index per display name; only
	// that index is generated below.
	OUTER_FOR (ejt_pre = 1; ejt_pre < ejt_total_rows; ++ejt_pre) BEGIN
		COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
			READ_2DA_ENTRY ejt_pre 0 9 ejt_pre_ind
			READ_2DA_ENTRY ejt_pre 3 9 ejt_pre_name
		OUTER_SPRINT ejt_pre_name_s ~%ejt_pre_name%~
		ACTION_IF NOT VARIABLE_IS_SET $EJT_NAME_MAX(~%ejt_pre_name_s%~) BEGIN
			OUTER_SET $EJT_NAME_MAX(~%ejt_pre_name_s%~) = ejt_pre_ind
		END ELSE BEGIN
			ACTION_IF (ejt_pre_ind > $EJT_NAME_MAX(~%ejt_pre_name_s%~)) BEGIN
				OUTER_SET $EJT_NAME_MAX(~%ejt_pre_name_s%~) = ejt_pre_ind
			END
		END
	END
	// Iterate through every real row (row 0 is the column-header placeholder row)
	OUTER_FOR (ejt_row = 1; ejt_row < ejt_total_rows; ++ejt_row) BEGIN
		COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
			READ_2DA_ENTRY ejt_row 0 9 ejt_ind
			READ_2DA_ENTRY ejt_row 1 9 ejt_dv
			READ_2DA_ENTRY ejt_row 2 9 ejt_cre
			READ_2DA_ENTRY ejt_row 3 9 ejt_name
		OUTER_SPRINT ejt_ind_str ~%ejt_ind%~
		OUTER_SPRINT ejt_dv_str ~%ejt_dv%~
		OUTER_SPRINT ejt_cre_str ~%ejt_cre%~
		OUTER_SPRINT ejt_name_str ~%ejt_name%~
		OUTER_INNER_PATCH_SAVE ejt_name_str ~%ejt_name_str%~ BEGIN
			REPLACE_TEXTUALLY ~_~ ~ ~
		END
		// Display name for the Wish genie's line. Some joinable CREs carry a
		// placeholder long name rather than the companion's own (Branwen's
		// recruitable CRE is the petrified "Statue"). In that case, build the
		// name from the death variable instead: BRANWEN -> Branwen.
		ACTION_IF (~%ejt_name_str%~ STRING_EQUAL_CASE ~Statue~) BEGIN
			OUTER_SPRINT ejt_name_str ~%ejt_dv%~
			OUTER_INNER_PATCH_SAVE ejt_name_str ~%ejt_name_str%~ BEGIN
				REPLACE_TEXTUALLY ~[_0-9]*$~ ~~
			END
			ACTION_TO_LOWER ejt_name_str
			OUTER_INNER_PATCH_SAVE ejt_name_str ~%ejt_name_str%~ BEGIN
				REPLACE_EVALUATE ~^\(.\)~ BEGIN TO_UPPER MATCH1 END ~%MATCH1%~
			END
		END

		// Gold cost for the new direct Raise Dead / Resurrection options
		// (see ejtemple-single.d), computed from this companion's OWN
		// creature file so pricing follows their actual level rather than a
		// flat fee. Level offsets confirmed via NearInfinity's
		// CreResource.java: CRE_LEVEL_FIRST_CLASS/SECOND/THIRD sit at
		// readOther()'s offset+556/557/558, and readOther's "offset" param
		// is fed in AFTER the reader consumes the 8-byte "CRE V1.0"
		// signature+version (confirmed via the same method's own
		// "offset += 8" just before calling readOther) -- so the true
		// absolute file offsets are 556+8=564=0x234, 565=0x235, 566=0x236.
		// BUGFIX: this previously read 0x22C/0x22D/0x22E (8 bytes too
		// early), silently pulling level data from the wrong field the
		// whole time this component existed. Cross-checked against three
		// other fields already read elsewhere in this exact file using the
		// same "offset+8" basis and known to work correctly: Allegiance/EA
		// at absolute 0x270, Class at 0x273 (both already used, and
		// correct, in the priest-detection scan above), and the genie's
		// own Override Script field at 0x248 (see the genie setup just
		// above this loop, and the pre-existing WRITE_ASCII 0x248 used for
		// EJdro%ind% further down this file) -- all consistent with the
		// same "code offset + 8" rule, confirming 0x234/0x235/0x236 rather
		// than the old 0x22C/0x22D/0x22E.
		// Formula matches Component 300's RAISDEAD.2DA: level x 1000gp,
		// clamped to that table's 1-40 range. Resurrection is priced at
		// double the Raise Dead rate -- this mod's own earlier design notes
		// (comp600.txt / EJTEMPLE_D.d) used a flat 5000/10000 2:1 ratio, so
		// this keeps that same ratio while making both figures level-scaled
		// instead of flat. Easy to change the multiplier later if wanted.
		OUTER_SET ejt_lvl1 = 0
		OUTER_SET ejt_lvl2 = 0
		OUTER_SET ejt_lvl3 = 0
		// ejt_anim: this companion's real Animation ID (CRE V1.0 offset 0x28,
		// 2 bytes -- confirmed via NearInfinity's CreResource.java: addField
		// for CRE_ANIMATION sits at readOther()'s offset+32, and per the same
		// "code offset + 8 = true file offset" rule already established for
		// the level fields just below, 32+8=0x28). Read from this companion's
		// own real CRE file, so it's always her own correct, original
		// appearance. CURRENTLY UNUSED: the Polymorph-based chunk fix this
		// fed was dropped (see the EJRJN comment further below); the
		// __ANIM__ substitutions in the .d generation are harmless no-ops.
		OUTER_SET ejt_anim = 0
		ACTION_IF FILE_EXISTS_IN_GAME ~%ejt_dv%.cre~ BEGIN
			COPY_EXISTING ~%ejt_dv%.cre~ ~override~
				READ_BYTE 0x234 ejt_lvl1_r
				READ_BYTE 0x235 ejt_lvl2_r
				READ_BYTE 0x236 ejt_lvl3_r
				READ_SHORT 0x28 ejt_anim_r
				SPRINT ejt_lvl1_s ~%ejt_lvl1_r%~
				SPRINT ejt_lvl2_s ~%ejt_lvl2_r%~
				SPRINT ejt_lvl3_s ~%ejt_lvl3_r%~
				SPRINT ejt_anim_s ~%ejt_anim_r%~
				INNER_ACTION BEGIN
					OUTER_SET ejt_lvl1 = %ejt_lvl1_s%
					OUTER_SET ejt_lvl2 = %ejt_lvl2_s%
					OUTER_SET ejt_lvl3 = %ejt_lvl3_s%
					OUTER_SET ejt_anim = %ejt_anim_s%
				END
			BUT_ONLY
		END
		// READ_SHORT reads a SIGNED 16-bit value, but Animation IDs are an
		// UNSIGNED 16-bit ID space and commonly exceed 0x7FFF (many ordinary
		// humanoid animations sit in the 0x6000-0xE000+ range) -- a signed
		// read of such a value comes back negative (e.g. 0xC000 reads as
		// -16384), and handing that straight to Polymorph's integer
		// parameter would sign-extend it to a completely different 32-bit
		// number, not the original unsigned ID. Correct it back to the true
		// unsigned 16-bit value before using it anywhere.
		ACTION_IF (ejt_anim < 0) BEGIN
			OUTER_SET ejt_anim = ejt_anim + 65536
		END
		OUTER_SPRINT ejt_anim_str ~%ejt_anim%~
		OUTER_SET ejt_lvl = ejt_lvl1
		ACTION_IF (ejt_lvl2 > ejt_lvl) BEGIN OUTER_SET ejt_lvl = ejt_lvl2 END
		ACTION_IF (ejt_lvl3 > ejt_lvl) BEGIN OUTER_SET ejt_lvl = ejt_lvl3 END
		ACTION_IF (ejt_lvl < 1) BEGIN OUTER_SET ejt_lvl = 1 END
		ACTION_IF (ejt_lvl > 40) BEGIN OUTER_SET ejt_lvl = 40 END
		OUTER_SET ejt_raise_cost = ejt_lvl * 1000
		OUTER_SET ejt_res_cost = ejt_lvl * 2000
		OUTER_SET ejt_raise_cost_m1 = ejt_raise_cost - 1
		OUTER_SET ejt_res_cost_m1 = ejt_res_cost - 1
		OUTER_SPRINT ejt_raise_cost_str ~%ejt_raise_cost%~
		OUTER_SPRINT ejt_res_cost_str ~%ejt_res_cost%~
		OUTER_SPRINT ejt_raise_cost_m1_str ~%ejt_raise_cost_m1%~
		OUTER_SPRINT ejt_res_cost_m1_str ~%ejt_res_cost_m1%~

		// NPCbods.2da has one row per CRE-file variant a companion has ever
		// used (e.g. Jaheira has separate BG1/SoD/BG2/ToB rows), all sharing
		// the same index -- without this check the loop below would compile
		// and EXTEND_BOTTOM the identical dialogue into the same priest's DLG
		// once per variant, producing several duplicate copies of the same
		// selectable line. Only process each index once.
		OUTER_SPRINT ejt_name_key ~%ejt_name%~
		OUTER_SET ejt_name_max = $EJT_NAME_MAX(~%ejt_name_key%~)
		ACTION_IF (ejt_ind = ejt_name_max) AND (NOT VARIABLE_IS_SET $EJT_SEEN_INDEX(~%ejt_ind_str%~)) BEGIN
		ACTION_DEFINE_ASSOCIATIVE_ARRAY EJT_SEEN_INDEX BEGIN ~%ejt_ind_str%~ => ~~ END

		// Join-after-revival watcher, one per companion, shared by BOTH the
		// temple-priest dialogue (ejtemple-single.d) and the Wish/genie
		// dialogue (ejtgenie-single.d). See either file's comments for why
		// this exists: a fixed Wait()+JoinParty() after ReallyForceSpellDead
		// is a real race (live-testing-confirmed) that can reproduce the
		// original null-pointer crash, silently fail to join her, or join
		// her only for the engine to immediately kick her back out. This
		// tiny placeholder (cloned from the same BODYDROP.CRE base as
		// EJdro%ind%, but its own dedicated resref so none of EJdro's
		// unrelated item-pickup/decay logic can interfere) just polls
		// Global("EJRejoinPending%ind%") and !Dead("%dv%") every round,
		// indefinitely, and only calls JoinParty() once that's genuinely
		// true.
		COPY ~npc-bodies/cre/BODYDROP.CRE~ ~override/EJRJN%ejt_ind_str%.cre~
			WRITE_ASCII 0x280 ~EJRJN%ejt_ind_str%~
			WRITE_ASCII 0x248 ~EJRJN%ejt_ind_str%~
		<<<<<<<< npc-inline/EJRJN%ejt_ind_str%.baf
		>>>>>>>>
		COPY ~npc-inline/EJRJN%ejt_ind_str%.baf~ ~weidu_external/npc-bodies/EJRJN%ejt_ind_str%.baf~
		// BUGFIX (chunked/permadeath revival), real cause found. Stratagems
		// restores a chunked companion's body with the Resurrection spell
		// itself: its resurrection.tpa sets opcode 32 (Raise dead, whose EE
		// parameter 2 is "Restore creature animation?") to 1 on the
		// Resurrection sub-spell (SPPR712A). A pure-Stratagems install
		// (no NPC Bodies) was confirmed by the user to reconstruct a
		// chunked Jaheira correctly with a plain Resurrection cast.
		//
		// That sub-spell is only applied when the target's GENERAL is DEAD
		// (the spell's own SPLPROT checks are rows 103/113, "GENERAL = n"
		// and "GENERAL != n"). This mod's scripts (baldurextend.baf) used to
		// overwrite a dead companion's GENERAL with the custom EJNOBOD
		// value whenever the party held no body item, which a chunked
		// companion never has -- so the animation-restoring sub-spell was
		// skipped for her, from a scroll, a Rod, or this watcher alike.
		// (The earlier destroy-and-recreate and Polymorph attempts were
		// both dropped: neither was how Stratagems does it.)
		//
		// Fixes: baldurextend.baf no longer sets EJNOBOD on a permanently
		// dead companion, and this watcher sets GENERAL back to DEAD
		// immediately before casting, so the real spell's own logic runs.
		// The watcher dispatches the right revival spell (EJRevSpell%ind%:
		// 1 = Raise Dead, 2 = Resurrection) and then polls for !Dead()
		// before joining her.
		APPEND_OUTER ~weidu_external/npc-bodies/EJRJN%ejt_ind_str%.baf~ ~
			IF
				Global("EJRejoinPending%ejt_ind_str%","GLOBAL",1)
				!Global("EJRevived%ejt_ind_str%","GLOBAL",1)
				Global("EJRevSpell%ejt_ind_str%","GLOBAL",1)
			THEN
				RESPONSE #100
					SetGlobal("EJRevived%ejt_ind_str%","GLOBAL",1)
					ChangeGeneral("%ejt_dv_str%",DEAD)
					ReallyForceSpellDead("%ejt_dv_str%",CLERIC_RAISE_DEAD)
			END
			IF
				Global("EJRejoinPending%ejt_ind_str%","GLOBAL",1)
				!Global("EJRevived%ejt_ind_str%","GLOBAL",1)
				Global("EJRevSpell%ejt_ind_str%","GLOBAL",2)
			THEN
				RESPONSE #100
					SetGlobal("EJRevived%ejt_ind_str%","GLOBAL",1)
					ChangeGeneral("%ejt_dv_str%",DEAD)
					ReallyForceSpellDead("%ejt_dv_str%",CLERIC_RESURRECTION)
			END
			IF
				Global("EJRejoinPending%ejt_ind_str%","GLOBAL",1)
				Global("EJRevived%ejt_ind_str%","GLOBAL",1)
				Global("EJRevSpell%ejt_ind_str%","GLOBAL",1)
				!Dead("%ejt_dv_str%")
			THEN
				RESPONSE #100
					SetGlobal("EJRevSpell%ejt_ind_str%","GLOBAL",3)
					SetGlobal("EJRAISED","GLOBAL",0)
					SetGlobal("EJwd%ejt_ind_str%","GLOBAL",0)
					SetGlobal("EJRDq%ejt_ind_str%","GLOBAL",1)
			END
			IF
				Global("EJRejoinPending%ejt_ind_str%","GLOBAL",1)
				Global("EJRevived%ejt_ind_str%","GLOBAL",1)
				Global("EJRevSpell%ejt_ind_str%","GLOBAL",2)
				!Dead("%ejt_dv_str%")
			THEN
				RESPONSE #100
					SetGlobal("EJRevSpell%ejt_ind_str%","GLOBAL",3)
					SetGlobal("EJRESD","GLOBAL",0)
					SetGlobal("EJRDs%ejt_ind_str%_1","GLOBAL",0)
					SetGlobal("EJRDs%ejt_ind_str%_2","GLOBAL",0)
					SetGlobal("EJRDs%ejt_ind_str%_3","GLOBAL",0)
					SetGlobal("EJRDs%ejt_ind_str%_4","GLOBAL",0)
					SetGlobal("EJRDs%ejt_ind_str%_5","GLOBAL",0)
					ApplySpellRES("EJRDR1","%ejt_dv_str%")
					ApplySpellRES("EJRDR2","%ejt_dv_str%")
					ApplySpellRES("EJRDR3","%ejt_dv_str%")
					ApplySpellRES("EJRDR4","%ejt_dv_str%")
					ApplySpellRES("EJRDR5","%ejt_dv_str%")
			END
			IF
				Global("EJRejoinPending%ejt_ind_str%","GLOBAL",1)
				Global("EJRevived%ejt_ind_str%","GLOBAL",1)
				!Dead("%ejt_dv_str%")
			THEN
				RESPONSE #100
					SetGlobal("EJwd%ejt_ind_str%","GLOBAL",0)
					SetGlobal("EJRejoinPending%ejt_ind_str%","GLOBAL",0)
					SetGlobal("EJRevived%ejt_ind_str%","GLOBAL",0)
					SetGlobal("EJRevSpell%ejt_ind_str%","GLOBAL",0)
					SetGlobal("EJdead%ejt_ind_str%","GLOBAL",0)
					TakePartyItem("EJB%ejt_ind_str%a")
					DestroyItem("EJB%ejt_ind_str%a")
					TakePartyItem("EJB%ejt_ind_str%b")
					DestroyItem("EJB%ejt_ind_str%b")
					ActionOverride("%ejt_dv_str%",JoinParty())
					DestroySelf()
			END~
		COMPILE ~weidu_external/npc-bodies/EJRJN%ejt_ind_str%.baf~

		// EJT_PRIEST_AREA only contains priests whose home area was actually
		// found during the single-pass scan above, so there's no NONE-sentinel
		// to check here -- a priest missing an area is simply absent from the
		// array and never generated.
		ACTION_PHP_EACH EJT_PRIEST_AREA AS priest => priest_args BEGIN
			ACTION_IF FILE_EXISTS_IN_GAME ~%priest%.dlg~ BEGIN
				COPY ~npc-bodies/ejtemple-single.d~ ~weidu_external/npc-bodies/ejtemple_%priest%_%ejt_ind_str%.d~
					REPLACE_TEXTUALLY ~__PRIEST__~ ~%priest%~
					REPLACE_TEXTUALLY ~__INDEX__~ ~%ejt_ind_str%~
					REPLACE_TEXTUALLY ~__DV__~ ~%ejt_dv_str%~
					REPLACE_TEXTUALLY ~__ANIM__~ ~%ejt_anim_str%~
					REPLACE_TEXTUALLY ~__MOVEGLOBAL_ARGS__~ ~%priest_args%~
					REPLACE_TEXTUALLY ~__RAISE_COST__~ ~%ejt_raise_cost_str%~
					REPLACE_TEXTUALLY ~__RAISE_COST_M1__~ ~%ejt_raise_cost_m1_str%~
					REPLACE_TEXTUALLY ~__RES_COST__~ ~%ejt_res_cost_str%~
					REPLACE_TEXTUALLY ~__RES_COST_M1__~ ~%ejt_res_cost_m1_str%~
				COMPILE ~weidu_external/npc-bodies/ejtemple_%priest%_%ejt_ind_str%.d~
			END
		END

		// Wish/genie: one free reply per eligible companion, appended into
		// WISH01's real dialogue state 0 (and WISH02's too, if it turned out
		// to be a genuinely different dialogue file) -- not one per priest,
		// so this runs once per companion index rather than once per
		// (priest, companion) pair.
		ACTION_IF FILE_EXISTS_IN_GAME ~WISH01.cre~ BEGIN
			COPY ~npc-bodies/ejtgenie-single.d~ ~weidu_external/npc-bodies/ejtgenie1_%ejt_ind_str%.d~
				REPLACE_TEXTUALLY ~__WISHDLG__~ ~%ejt_wishdlg1_str%~
				REPLACE_TEXTUALLY ~__INDEX__~ ~%ejt_ind_str%~
				REPLACE_TEXTUALLY ~__DV__~ ~%ejt_dv_str%~
				REPLACE_TEXTUALLY ~__ANIM__~ ~%ejt_anim_str%~
				REPLACE_TEXTUALLY ~__NAME__~ ~%ejt_name_str%~
			COMPILE ~weidu_external/npc-bodies/ejtgenie1_%ejt_ind_str%.d~
			ACTION_IF (ejt_have_wishdlg2 = 1) BEGIN
				COPY ~npc-bodies/ejtgenie-single.d~ ~weidu_external/npc-bodies/ejtgenie2_%ejt_ind_str%.d~
					REPLACE_TEXTUALLY ~__WISHDLG__~ ~%ejt_wishdlg2_str%~
					REPLACE_TEXTUALLY ~__INDEX__~ ~%ejt_ind_str%~
					REPLACE_TEXTUALLY ~__DV__~ ~%ejt_dv_str%~
					REPLACE_TEXTUALLY ~__ANIM__~ ~%ejt_anim_str%~
					REPLACE_TEXTUALLY ~__NAME__~ ~%ejt_name_str%~
				COMPILE ~weidu_external/npc-bodies/ejtgenie2_%ejt_ind_str%.d~
			END
		END
		END
	END
END

// =============================================================================
// Component 700: Player-Created Character Revival [EXPERIMENTAL]
// Separate component so it can be installed/uninstalled on its own while it is
// being tested. All logic lives in comp700.tpa.
// =============================================================================
BEGIN @700 // Player-Created Character Revival [EXPERIMENTAL]
DESIGNATED 700
LABEL ~NPC_BODIES_PC_REVIVAL~
REQUIRE_COMPONENT ~npc-bodies.tp2~ 600 ~Requires Component 600 (Temple Resurrection of Fallen Companions)~

INCLUDE ~npc-bodies/comp700.tpa~

// =============================================================================
// Component 800: Diamonds required for Resurrection (pick one). Replaces
// Stratagems' single-diamond check (which ate whole stacks). Logic in
// comp800.tpa.
// =============================================================================
BEGIN @801 DESIGNATED 800 SUBCOMPONENT @800
REQUIRE_COMPONENT ~stratagems/setup-stratagems.tp2~ 4130 ~Requires Stratagems component 4130 (Revised handling of death effects).~
OUTER_SET ejd_count = 0
INCLUDE ~npc-bodies/comp800.tpa~

BEGIN @802 DESIGNATED 801 SUBCOMPONENT @800
REQUIRE_COMPONENT ~stratagems/setup-stratagems.tp2~ 4130 ~Requires Stratagems component 4130 (Revised handling of death effects).~
OUTER_SET ejd_count = 1
INCLUDE ~npc-bodies/comp800.tpa~

BEGIN @803 DESIGNATED 802 SUBCOMPONENT @800
REQUIRE_COMPONENT ~stratagems/setup-stratagems.tp2~ 4130 ~Requires Stratagems component 4130 (Revised handling of death effects).~
OUTER_SET ejd_count = 2
INCLUDE ~npc-bodies/comp800.tpa~

BEGIN @804 DESIGNATED 803 SUBCOMPONENT @800
REQUIRE_COMPONENT ~stratagems/setup-stratagems.tp2~ 4130 ~Requires Stratagems component 4130 (Revised handling of death effects).~
OUTER_SET ejd_count = 3
INCLUDE ~npc-bodies/comp800.tpa~

BEGIN @805 DESIGNATED 804 SUBCOMPONENT @800
REQUIRE_COMPONENT ~stratagems/setup-stratagems.tp2~ 4130 ~Requires Stratagems component 4130 (Revised handling of death effects).~
OUTER_SET ejd_count = 4
INCLUDE ~npc-bodies/comp800.tpa~

BEGIN @806 DESIGNATED 805 SUBCOMPONENT @800
REQUIRE_COMPONENT ~stratagems/setup-stratagems.tp2~ 4130 ~Requires Stratagems component 4130 (Revised handling of death effects).~
OUTER_SET ejd_count = 5
INCLUDE ~npc-bodies/comp800.tpa~

// =============================================================================
// Component 900: Petrified main character can be shattered (Stratagems'
// main-character statue, or Spell Revisions' petrification). Logic and notes
// in comp900.tpa.
// =============================================================================
BEGIN @900 DESIGNATED 900
REQUIRE_COMPONENT ~stratagems/setup-stratagems.tp2~ 4130 ~Requires Stratagems component 4130 (Revised handling of death effects).~
FORBID_COMPONENT ~cdtweaks/setup-cdtweaks.tp2~ 3300 ~Not compatible with cdtweaks' Death Cam, which ends the game when the main character is petrified. Uninstall it and use NPC Bodies' own Death Cam (Component 1200) instead.~
INCLUDE ~npc-bodies/comp900.tpa~

// =============================================================================
// Component 1000: Greater Restoration cures Raise Dead CON penalties (pick
// how many stacks one casting removes). Logic in comp1000.tpa.
// =============================================================================
BEGIN @1001 DESIGNATED 1000 SUBCOMPONENT @1000
REQUIRE_COMPONENT ~npc-bodies.tp2~ 200 ~Requires Component 200 (Raise Dead / Resurrection penalties)~
OUTER_SET ejg_count = 1
INCLUDE ~npc-bodies/comp1000.tpa~

BEGIN @1002 DESIGNATED 1001 SUBCOMPONENT @1000
REQUIRE_COMPONENT ~npc-bodies.tp2~ 200 ~Requires Component 200 (Raise Dead / Resurrection penalties)~
OUTER_SET ejg_count = 2
INCLUDE ~npc-bodies/comp1000.tpa~

BEGIN @1003 DESIGNATED 1002 SUBCOMPONENT @1000
REQUIRE_COMPONENT ~npc-bodies.tp2~ 200 ~Requires Component 200 (Raise Dead / Resurrection penalties)~
OUTER_SET ejg_count = 3
INCLUDE ~npc-bodies/comp1000.tpa~

BEGIN @1004 DESIGNATED 1003 SUBCOMPONENT @1000
REQUIRE_COMPONENT ~npc-bodies.tp2~ 200 ~Requires Component 200 (Raise Dead / Resurrection penalties)~
OUTER_SET ejg_count = 5
INCLUDE ~npc-bodies/comp1000.tpa~

// =============================================================================
// Component 1100 [EXPERIMENTAL]: Travel while the main character is
// petrified (a token sends the statue to a holding room and brings it back).
// Logic in comp1100.tpa.
// =============================================================================
BEGIN @1100 DESIGNATED 1100
REQUIRE_COMPONENT ~npc-bodies.tp2~ 900 ~Requires Component 900 (Petrified main character can be shattered)~
INCLUDE ~npc-bodies/comp1100.tpa~

// =============================================================================
// Component 1200: NPC Bodies Death Cam (cdtweaks' Death Cam, made compatible
// with petrification). Logic in comp1200.tpa.
// =============================================================================
BEGIN @1200 DESIGNATED 1200
FORBID_COMPONENT ~cdtweaks/setup-cdtweaks.tp2~ 3300 ~cdtweaks' Death Cam is already installed; uninstall it first (this component replaces it).~
INCLUDE ~npc-bodies/comp1200.tpa~
