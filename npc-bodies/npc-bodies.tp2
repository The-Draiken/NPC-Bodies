
BACKUP ~weidu_external/backup/npc-bodies~
AUTHOR ~EnigmaJazz based on original mod by gunman~
AUTO_EVAL_STRINGS
ALWAYS
	INCLUDE ~npc-bodies/misc_functions.tpa~
END
ASK_EVERY_COMPONENT
AUTO_TRA ~npc-bodies/tra/%s~
LANGUAGE ~English~
         ~english~
         ~npc-bodies/tra/english/setup.tra~





BEGIN @100 //Main compoonent
DESIGNATED 100
LABEL ~NPC_BODIES_MAIN_COMPONENT~


<<<<<<<< npc-inline/NPCbods.2da
2DA V1.0 
INDEX	DV	CRE	NAME	SCRIPT	RACE	GENDER	WEIGHT	
0		#	#	#		#		#		#		#		
>>>>>>>> 

COPY ~npc-inline/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~ 



<<<<<<<< npc-inline/baldurextend.baf
>>>>>>>>
COPY ~npc-inline/baldurextend.baf~ ~weidu_external/npc-bodies/baldurextend.baf~ 

LAM JOINABLE_NPC_ARRAYS
OUTER_SET bind = 1

LAF ADD_IDS_ENTRY STR_VAR idsFile =  "GENERAL" identifier = "EJNOBOD" RET value END
ACTION_IF (value >= 0) BEGIN
  OUTER_SET EJNOBOD = value
END
LAF ADD_SPLPROT_ENTRY INT_VAR stat = 0x10b STR_VAR identifier = "EJNOBOD" value = "%EJNOBOD%" relation  = "1" RET index END
ACTION_IF (index >= 0) BEGIN
  OUTER_SET nobodprot = index
END
LAF ADD_SPLPROT_ENTRY INT_VAR stat = 0x103 STR_VAR identifier = "EJDead" value = "%nobodprot%" relation  = "74" RET index END
ACTION_IF (index >= 0) BEGIN
  OUTER_SET deadprot = index
END
LAF ADD_SPLPROT_ENTRY INT_VAR stat = 0x104 STR_VAR identifier = "EJAlive" value = "%nobodprot%" relation  = "74" RET index END
ACTION_IF (index >= 0) BEGIN
  OUTER_SET aliveprot = index
END
APPEND "state.ids" "0x000007C0 STATE_PERMANENT_DEATH" UNLESS "STATE_PERMANENT_DEATH"

ACTION_PHP_EACH JOINABLE_NPC_ARRAY AS cre => dv BEGIN
	OUTER_SET ind = 0
	OUTER_SET skip = 0
	COPY_EXISTING ~%cre%~ ~override~
		READ_STRREF 0x8 name
		READ_BYTE  0x272 race
		READ_ASCII 0x248 script
		READ_BYTE 0x275 gender
		READ_BYTE 0x271 general
		PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Ajantis~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 182
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Alora~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 42
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Branwen~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 118
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Coran~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 106
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Dorn~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 182
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Dynaheir~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 106 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Edwin~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 134 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Eldoth~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 176 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Faldorn~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 112 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Garrick~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 106 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Imoen~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 94 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Jaheira~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 105 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Kagain~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 160 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Khalid~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 130 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Kivan~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 122 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Minsc~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 188 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Montaron~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 70 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Neera~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 89 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Quayle~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 66 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Rasaad~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 176 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Safana~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 118 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Shar-Teel~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 148 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Skie~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 106 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Tiax~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 69 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Viconia~) BEGIN
				TEXT_SPRINT body ~DEADFEMA~
				SET weight = 110 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Xan~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 102 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Xsar~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 164 
			END ELSE
			PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Yeslick~) BEGIN
				TEXT_SPRINT body ~DEADMALE~
				SET weight = 155 
			END ELSE
			PATCH_IF gender = 1 BEGIN //male
				TEXT_SPRINT body ~DEADMALE~
				PATCH_IF race = 1 BEGIN //human
					SET weight = RANDOM(130 220) 
				END ELSE
				PATCH_IF race = 2 BEGIN //elf
					SET weight = RANDOM(110 195) 
				END ELSE
				PATCH_IF race = 3 BEGIN //half-elf
					SET weight = RANDOM(120 210) 
				END ELSE
				PATCH_IF race = 4 BEGIN //dwarf
					SET weight = RANDOM(130 190) 
				END ELSE
				PATCH_IF race = 5 BEGIN //halfling
					SET weight = RANDOM(40 75) 
				END ELSE
				PATCH_IF race = 6 BEGIN //gnome
					SET weight = RANDOM(35 65) 
				END ELSE
				PATCH_IF race = 7 BEGIN //half orc
					SET weight = RANDOM(170 250) 
				END ELSE
					SET weight = RANDOM(130 210) //any other race if used for some reason
			END ELSE
			TEXT_SPRINT body ~DEADFEMA~ //all other genders, presumably female most of the time
			PATCH_IF race = 1 BEGIN //human
				SET weight = RANDOM(110 170) 
			END ELSE
			PATCH_IF race = 2 BEGIN //elf
				SET weight = RANDOM(105 165) 
			END ELSE
				PATCH_IF race = 3 BEGIN //half-elf
				SET weight = RANDOM(110 180) 
			END ELSE
			PATCH_IF race = 4 BEGIN //dwarf
				SET weight = RANDOM(110 175) 
			END ELSE
			PATCH_IF race = 5 BEGIN //halfling
				SET weight = RANDOM(30 55) 
			END ELSE
			PATCH_IF race = 6 BEGIN //gnome
				SET weight = RANDOM(25 55) 
			END ELSE
			PATCH_IF race = 7 BEGIN //half orc
				SET weight = RANDOM(160 205) 
			END ELSE
			SET weight = RANDOM(110 195) //any other race if used for some reason
			
	OUTER_INNER_PATCH_SAVE name ~%name%~ BEGIN
			REPLACE_TEXTUALLY ~ ~ ~_~
	END		
		ACTION_IF (~%script%~ STRING_EQUAL_CASE ~none~) BEGIN
			OUTER_SET skip = 1
		END	
		ACTION_IF (~%script%~ STRING_EQUAL_CASE ~~) BEGIN
			OUTER_SET skip = 1
		END
		// Skip undead (race 125) - vampires and other undead don't drop bodies
		ACTION_IF (race = 125) BEGIN
			OUTER_SET skip = 1
		END
	COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
		COUNT_2DA_COLS cols
		READ_2DA_ENTRIES_NOW ~r2en_bods~ cols
		FOR (row = 0; row < r2en_bods; ++row) BEGIN
			READ_2DA_ENTRY_FORMER ~r2en_bods~ row 0 prev_ind
			READ_2DA_ENTRY_FORMER ~r2en_bods~ row 1 prev_dv
			READ_2DA_ENTRY_FORMER ~r2en_bods~ row 4 prev_script
			READ_2DA_ENTRY_FORMER ~r2en_bods~ row 7 prev_weight
			PATCH_IF (skip = 0) BEGIN
				PATCH_IF (~%dv%~ STRING_EQUAL_CASE ~%prev_dv%~) BEGIN
					SET ind = prev_ind
					SET weight = prev_weight					
					PATCH_IF (~%script%~ STRING_EQUAL_CASE ~%prev_script%~) BEGIN
						SET skip = 1
					END	
				END
			END
		END
		
	ACTION_IF (ind = 0) BEGIN
			OUTER_SET ind = bind
			OUTER_SET bind += 1	
	END
		
	ACTION_IF (skip = 0)	BEGIN
		APPEND_OUTER ~weidu_external/npc-bodies/NPCbods.2da~ ~%ind% %dv%	%cre%	%name%	%script%	%race%	%gender% %weight% %general%~
		OUTER_INNER_PATCH_SAVE name ~%name%~ BEGIN
			REPLACE_TEXTUALLY ~_~ ~ ~
		END
		COPY	~npc-bodies/itm/%body%.itm~ ~override/EJB%ind%a.itm~
				SAY NAME1 @1
				SAY NAME2 @1
				SAY UNIDENTIFIED_DESC @2
				SAY DESC @2
				WRITE_LONG 0x4c ~%weight%~
					
					
		COPY ~npc-bodies/cre/BODYDROP.CRE~ ~override/EJdro%ind%.cre~
				WRITE_ASCII 0x280 ~EJdro%ind%~
	
		<<<<<<<< npc-inline/%script%.baf
		>>>>>>>> 			
		COPY ~npc-inline/%script%.baf~ ~weidu_external/npc-bodies/%script%.baf~
		
				
		APPEND_OUTER ~weidu_external/npc-bodies/%script%.baf~ ~ 
			IF
				InParty("%dv%")
				!Dead("%dv%")
				PartyHasItem("EJB%ind%a")
				Global("EJdead%ind%","GLOBAL",1)
			THEN
				RESPONSE #100
					SetGlobal("EJdead%ind%","GLOBAL",0)
					ChangeGeneral("%dv%","%general%")
					CreateCreatureObject("EJdro%ind%","%dv%",0,0,0)
					ActionOverride("EJdro%ind%",TakePartyItem("EJB%ind%a")) 
					ActionOverride("EJdro%ind%",DestroyItem("EJB%ind%a"))
					ActionOverride("EJdro%ind%",DestroySelf())
					Continue()
			END
			IF
				InParty("%dv%")
				!Dead("%dv%")
				!PartyHasItem("EJB%ind%a")
				Global("EJdead%ind%","GLOBAL",1)
			THEN
				RESPONSE #100
					SetGlobal("EJdead%ind%","GLOBAL",0)
					ChangeGeneral("%dv%","%general%")
					CreateCreatureObject("EJdro%ind%","%dv%",0,0,0)
					ActionOverride("EJdro%ind%",PickUpItem("EJB%ind%a")) 
					ActionOverride("EJdro%ind%",DestroyItem("EJB%ind%a"))
					ActionOverride("EJdro%ind%",DestroySelf())
					Continue()
			END
			IF
				Dead("%dv%")
				!StateCheck("%dv%",STATE_PERMANENT_DEATH)
				Global("EJdead%ind%","GLOBAL",0)
			THEN
				RESPONSE #100
					SetGlobal("EJdead%ind%","GLOBAL",1)
					SaveObjectLocation("MYAREA","Corpse%ind%","%dv%")
					CreateCreatureAtLocation("Corpse%ind%","MYAREA","EJdro%ind%")
					ActionOverride("EJdro%ind%",CreateItem("EJB%ind%a",0,0,0))
					ActionOverride("EJdro%ind%",DropItem("EJB%ind%a",[-1.-1]))
					ActionOverride("EJdro%ind%",DestroySelf())
					Continue()
			END
			// BUGFIX: the block above explicitly excludes STATE_PERMANENT_DEATH
			// (chunking, disintegration, etc.), which was clearly intentional
			// for the ORIGINAL body-drop system -- there's no body left to save
			// a location for or drop an item from. But that also means
			// EJdead%ind% NEVER gets set to 1 for a permanently-dead companion,
			// which is the ONLY flag Component 600's temple-priest and
			// Wish/genie dialogues gate on. This block catches that case
			// separately, with no body-item handling at all (there's
			// genuinely nothing to save), just the one flag Component 600
			// actually needs.
			//
			// NOTE: live testing showed this specific placement (this
			// companion's own class script, %script%.bcs) does NOT reliably
			// catch it -- the user still got no dialogue option after a
			// chunk+Stratagems-cure+dismiss cycle. Left in place as a
			// harmless belt-and-suspenders check (costs nothing if it never
			// fires), but the version that's actually confirmed-plausible to
			// work is the one added to baldurextend.baf a bit further down
			// (BG2's always-on global script, not tied to whatever script
			// slot happens to be active on this specific creature during the
			// permanent-death transition).
			IF
				StateCheck("%dv%",STATE_PERMANENT_DEATH)
				Global("EJdead%ind%","GLOBAL",0)
			THEN
				RESPONSE #100
					SetGlobal("EJdead%ind%","GLOBAL",1)
					Continue()
			END~
					
					
		EXTEND_BOTTOM ~%script%.bcs~ ~weidu_external/npc-bodies/%script%.baf~
		
		ACTION_IF !FILE_CONTAINS_EVALUATED(~weidu_external/npc-bodies/baldurextend.baf~ ~EJB%ind%a~) BEGIN

			APPEND_OUTER ~weidu_external/npc-bodies/baldurextend.baf~ ~
				// EJjoined%ind%: set once this companion has ever been in the
				// party (alive or dead). Component 600's temple/genie replies
				// require it, so NPCs who were never recruited (e.g. the
				// Branwen statue, whose death variable reads as Dead) never get
				// a revival line.
				IF
					InPartyAllowDead("%dv%")
					!Global("EJjoined%ind%","GLOBAL",1)
				THEN
					RESPONSE #100
						SetGlobal("EJjoined%ind%","GLOBAL",1)
				END

				// BUGFIX: never relabel a PERMANENTLY dead (chunked) companion
				// as EJNOBOD. The real Resurrection spell only applies its
				// raising sub-spell (the one Stratagems edits so Raise Dead
				// restores the creature animation) to a target whose GENERAL
				// is DEAD, so overwriting it here stopped Stratagems' own
				// chunk recovery from ever running for a rejoined companion.
				IF
					InPartyAllowDead("%dv%")
					Global("EJdead%ind%","GLOBAL",1)
					!PartyHasItem("EJB%ind%a")
					!StateCheck("%dv%",STATE_PERMANENT_DEATH)
				THEN
					RESPONSE #100
						ChangeGeneral("%dv%",EJNOBOD)
					END

				IF
					InPartyAllowDead("%dv%")
					Global("EJdead%ind%","GLOBAL",1)
					PartyHasItem("EJB%ind%a")
				THEN
					RESPONSE #100
						ChangeGeneral("%dv%",DEAD)
				END

				// BUGFIX (2nd attempt): the StateCheck(STATE_PERMANENT_DEATH)
				// trigger added to %script%.bcs (this companion's own class
				// script, above) did NOT fire in live testing -- confirmed by
				// the user still getting no dialogue option at all after a
				// chunk+Stratagems-cure+dismiss cycle. Likely cause: whatever
				// script slot %script%.bcs actually is, it's probably not the
				// one actively assigned to/evaluated for this creature during
				// the permanent-death window (the engine, or Stratagems
				// itself, may swap her active script during that transition).
				// baldur.bcs/bdbaldur.bcs/baldur25.bcs (this file, extended
				// onto all three a bit further down) are BG2's always-on,
				// area-independent global scripts -- they keep running
				// regardless of any individual creature's own script-slot
				// state, so a name-based trigger here doesn't depend on
				// %script%.bcs being the active script at the right moment.
				// Confirmed via Stratagems' own gameplay/resurrection.tpa
				// (local_add.baf) that StateCheck(...,STATE_PERMANENT_DEATH)
				// on a chunked party member DOES still resolve successfully
				// via a name/Myself reference at this stage -- Stratagems
				// relies on exactly that to re-JoinParty() her (still
				// permanently dead) so its own diamond-check dialogue has
				// time to run. This trigger piggybacks on that same window.
				IF
					StateCheck("%dv%",STATE_PERMANENT_DEATH)
					Global("EJdead%ind%","GLOBAL",0)
				THEN
					RESPONSE #100
						SetGlobal("EJdead%ind%","GLOBAL",1)
				END~
		END
	END
END

ACTION_FOR_EACH baldur IN ~baldur~ ~bdbaldur~ ~baldur25~ BEGIN
	ACTION_IF (FILE_EXISTS_IN_GAME ~%baldur%.bcs~) BEGIN
		EXTEND_BOTTOM ~%baldur%.bcs~ ~weidu_external/npc-bodies/baldurextend.baf~
	END
END

LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~CLERIC_RAISE_DEAD~  RET spell_res END //raise dead which is cast by temples
OUTER_TEXT_SPRINT raisedead ~%spell_res%~
COPY_EXISTING ~%raisedead%.spl~ ~override~
		READ_STRREF 0x50 ~raise~
		SAY 0x50 @4
		LPF CD_EXTEND-O-MATIC INT_VAR level_cap = 2 base_dur = 0 step_dur = 0 min_dur = 0 END 
		LPF ADD_SPELL_EFFECT INT_VAR header = 2 insert_point = 0 target = 2 opcode = 326 parameter1 = 0 parameter2 = EVAL %nobodprot% timing = 1 STR_VAR resource = ~EJNPRES~ END 
	

LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~CLERIC_RECALL_SPIRIT~  RET spell_res END
COPY_EXISTING ~%spell_res%.spl~ ~override~
	READ_STRREF 0x50 ~raise~
	SAY 0x50 @4
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 target = 2 opcode = 326 parameter1 = 0 parameter2 = EVAL %nobodprot% timing = 1 STR_VAR resource = ~EJNPRES~ END 
	
LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~CLERIC_MASS_RAISE_DEAD~  RET spell_res END
COPY_EXISTING ~%spell_res%.spl~ ~override~
	READ_STRREF 0x50 ~raise~
	SAY 0x50 @4
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 target = 6 opcode = 326 parameter1 = 0 parameter2 = EVAL %nobodprot% timing = 1 STR_VAR resource = ~EJNPRES~ END 

COPY_EXISTING ~SPJA01.spl~ ~override~ 
	READ_STRREF 0x50 ~raise~
	SAY 0x50 @4
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 target = 2 opcode = 326 parameter1 = 0 parameter2 = EVAL %nobodprot% timing = 1 STR_VAR resource = ~EJNPRES~ END 

COPY_EXISTING ~spwish10.spl~ ~override~ 
	READ_STRREF 0x50 ~raise~
	SAY 0x50 @4
	LPF ADD_SPELL_EFFECT INT_VAR insert_point = 0 target = 2 opcode = 326 parameter1 = 0 parameter2 = EVAL %nobodprot% timing = 1 STR_VAR resource = ~EJNPRES~ END 			
		
COPY ~npc-bodies/spl/EJNPRES.spl~ ~override~
	LPF ALTER_EFFECT INT_VAR match_opcode = 139 parameter1 = RESOLVE_STR_REF (@3) END

LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~CLERIC_RESURRECTION~  RET spell_res END
OUTER_TEXT_SPRINT resurrection ~%spell_res%~
COPY_EXISTING ~%resurrection%.spl~ ~override~
	READ_STRREF 0x50 ~res~
	SAY 0x50 @5
	LPF ALTER_EFFECT INT_VAR match_opcode = 324 match_parameter1 = 3 match_parameter2 = 113 parameter1 = 0 parameter2 = EVAL %aliveprot% END
	LPF ALTER_EFFECT INT_VAR match_opcode = 326 match_parameter1 = 3 match_parameter2 = 103 parameter1 = 0 parameter2 = EVAL %deadprot% END
			

//Adjust temple description
COPY_EXISTING ~speldesc.2da~ ~override~
  COUNT_2DA_COLS cols
  COUNT_2DA_ROWS cols rows
	FOR (row = 0; row < rows; ++row) BEGIN
		READ_2DA_ENTRY row 0 cols spell
		PATCH_IF (~%spell%~ STRING_EQUAL_CASE ~%raisedead%~) BEGIN
			READ_2DA_ENTRY row 1 cols raise_desc
		END
		PATCH_IF (~%spell%~ STRING_EQUAL_CASE ~%resurrection%~) BEGIN
			READ_2DA_ENTRY row 1 cols res_desc
		END
	END
	ACTION_GET_STRREF raise_desc raise
	ACTION_GET_STRREF res_desc res
	OUTER_SET raise_description=RESOLVE_STR_REF(@4)  
	OUTER_SET res_description=RESOLVE_STR_REF(@5)    
COPY_EXISTING ~speldesc.2da~ ~override~
  COUNT_2DA_COLS cols
  COUNT_2DA_ROWS cols rows
	FOR (row = 0; row < rows; ++row) BEGIN
		READ_2DA_ENTRY row 0 cols spell
		PATCH_IF (~%spell%~ STRING_EQUAL_CASE ~%raisedead%~) BEGIN
			SET_2DA_ENTRY row 1 cols raise_description
		END
		PATCH_IF (~%spell%~ STRING_EQUAL_CASE ~%resurrection%~) BEGIN
			SET_2DA_ENTRY row 1 cols res_description
		END
	END	



BEGIN @200 // Raise Dead Con Penalty / Resurrection MaxHP Penalty
DESIGNATED 200
// -----------------------------------------------------------------------------
// Raise Dead: -1 CON on the TARGET (the person being raised), no caster penalty.
// Resurrection: -8 maximum HP on the CASTER only. Temple casts are immune.
// -----------------------------------------------------------------------------

COPY ~npc-bodies/For Temples/EJTRD.SPL~  ~override/EJTRD.SPL~
COPY ~npc-bodies/For Temples/EJTRES.SPL~ ~override/EJTRES.SPL~
	// EJTRES: grant immunity to opcode 18 (max HP penalty) so temple Resurrection is penalty-free
	// BUGFIX: opcode 101 ("Protection from Opcode") takes the opcode-to-
	// protect-against in PARAMETER2, not parameter1 (parameter1 is unused
	// for this opcode) -- confirmed via IESDP's bgee.htm opcode list. This
	// was backwards, so the immunity effect was granting protection from
	// opcode 0, never opcode 18, and never actually did anything. Directly
	// responsible for a real bug reported by the user: a temple priest
	// (Keldath) who repeatedly cast Resurrection for the player eventually
	// died, because the -8 max HP penalty below was hitting him every time
	// with no immunity ever applying.
	// The immunity is now short-lived (timing 0, 6 seconds -- long enough to
	// cover the penalty's 2-second delay) instead of timing 2, which on a
	// spell effectively never expired. Any 101 already in the source file is
	// removed first so only this one exists.
	LPF ~DELETE_SPELL_EFFECT~ INT_VAR opcode_to_delete = 101 END
	LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 101 target = 2 power = 0 timing = 0 duration = 6 parameter1 = 0 parameter2 = 18 resist_dispel = 0 probability1 = 100 END

// EJRDCON: the Raise Dead -1 CON penalty (2 in-game weeks = 100800 game
// seconds). It is applied from the raise spells through a DELAYED opcode 326
// (1 second, like the existing "set HP to 1" effect). Applied directly, the
// CON effect landed while the target was still dead and was discarded.
COPY ~npc-bodies/For Temples/EJTRD.SPL~ ~override/EJRDCON.SPL~
	LPF ~DELETE_SPELL_EFFECT~ INT_VAR opcode_to_delete = "-1" END
	LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 10 target = 2 power = 0 parameter1 = (0 - 1) parameter2 = 0 timing = 0 duration = 100800 resist_dispel = 0 probability1 = 100 END

// Stackable Raise Dead CON penalty: up to 5 stacks per character.
// EJRDC<j>: +20 HP first (so a character raised at 1 HP is not killed by the
// lower CON hit-point bonus), then -1 CON with timing 9, which survives later
// deaths (a timed effect would be wiped on death, so stacks never built up).
// Each stack is removed after 2 in-game weeks by a script timer applying
// EJRDR<j> (opcode 321: remove effects of EJRDC<j>).
OUTER_FOR (ejrd_j = 1; ejrd_j <= 5; ++ejrd_j) BEGIN
	COPY ~npc-bodies/For Temples/EJTRD.SPL~ ~override/EJRDC%ejrd_j%.SPL~
		LPF ~DELETE_SPELL_EFFECT~ INT_VAR opcode_to_delete = "-1" END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 17 target = 2 power = 0 parameter1 = 20 parameter2 = 0 timing = 1 resist_dispel = 0 probability1 = 100 END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 10 target = 2 power = 0 parameter1 = (0 - 1) parameter2 = 0 timing = 9 duration = 0 resist_dispel = 0 probability1 = 100 END
	COPY ~npc-bodies/For Temples/EJTRD.SPL~ ~override/EJRDR%ejrd_j%.SPL~
		LPF ~DELETE_SPELL_EFFECT~ INT_VAR opcode_to_delete = "-1" END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 321 target = 2 power = 0 timing = 1 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJRDC%ejrd_j%~ END
END

ACTION_FOR_EACH res_spell IN ~CLERIC_RAISE_DEAD~ ~CLERIC_MASS_RAISE_DEAD~ ~CLERIC_RECALL_SPIRIT~ ~CLERIC_RESURRECTION~ BEGIN
	LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~%res_spell%~  RET spell_res END
	ACTION_IF FILE_EXISTS_IN_GAME  ~%spell_res%.spl~ BEGIN
		COPY_EXISTING ~%spell_res%.SPL~ ~override~
			READ_STRREF 0x50 ~desc~
			SAY 0x50 @6

			// Apply temple-immunity subspell FIRST (order of operations matters)
			// You confirmed the cast needs: Cast instantly (specified level)=2, Target=Self, Timing=Instant/Limited.
			PATCH_IF (~%res_spell%~ STRING_EQUAL_CASE ~CLERIC_RAISE_DEAD~) BEGIN
				// EJTRD is no longer cast. Raise Dead has no caster penalty, and in the
				// temple store the dead character is both caster and target, so an
				// immunity cast "on the caster" landed on the person being raised and
				// blocked their -1 CON penalty.
			END
			// Resurrection: EJTRES (immunity to the -8 max HP penalty) is applied
			// ONLY when the caster IS the target. That is exactly the temple store
			// case, where the engine has the dead party member "cast" the service
			// on themselves. Opcode 326 checks SPLPROT row 43 (SOURCE: target is
			// the caster) on the spell's target; a real cleric raising someone
			// else fails the check, gets no immunity, and pays the penalty.
			// (Previously EJTRES was cast on EVERY caster via opcode 146, so no
			// one ever paid it, and the immunity lingered afterwards.)
			PATCH_IF (~%res_spell%~ STRING_EQUAL_CASE ~CLERIC_RESURRECTION~) BEGIN
				LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 326 target = 2 power = 0 timing = 1 parameter1 = 0 parameter2 = 43 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJTRES~ END
				// EJRESD: "this revival was a Resurrection" -- blocks the Raise
				// Dead CON penalty even if a Raise Dead flag is still pending.
				LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 265 target = 3 power = 0 parameter1 = 1 parameter2 = 0 timing = 1 resist_dispel = 0 probability1 = 100 insert_point = 1 STR_VAR resource = ~EJRESD~ END
				LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 265 target = 1 power = 0 parameter1 = 1 parameter2 = 0 timing = 1 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJRESD~ END
			END

			// (1) Keep whatever you were doing with HP scaling (effect 17)
			LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 17 target = 2 power = 7 parameter1 = 100 parameter2 = 2 timing = 1 resist_dispel = 0 probability1 = 100 END
			// (2) Penalty effects
			// Raise Dead: -1 CON on the TARGET (the person being raised), no caster penalty.
			// CHANGED FROM PERMANENT TO TEMPORARY (2 in-game weeks) per user
			// request. timing=10 is BGEE's "Instant/Limited, duration given
			// directly in ticks" mode (confirmed via IESDP's EFF V1/V2 docs);
			// 15 ticks/second, 300 seconds/in-game hour, so 1 in-game day =
			// 108000 ticks and 2 weeks (14 days) = 1512000 ticks. Previously
			// timing=4/duration=2 (permanent, matching this codebase's other
			// permanent effects) -- was never actually reported as a problem,
			// this is a deliberate design change, not a bugfix.
			PATCH_IF (NOT (~%res_spell%~ STRING_EQUAL_CASE ~CLERIC_RESURRECTION~)) BEGIN
				LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 265 target = 3 power = 0 parameter1 = 1 parameter2 = 0 timing = 1 resist_dispel = 0 probability1 = 100 insert_point = 1 STR_VAR resource = ~EJRAISED~ END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 265 target = 1 power = 0 parameter1 = 1 parameter2 = 0 timing = 1 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJRAISED~ END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 265 target = 1 power = 0 parameter1 = 1 parameter2 = 0 timing = 4 duration = 2 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJRAISED~ END
			END

			// Resurrection: -8 maximum HP on the CASTER (opcode 18). EJTRES grants immunity for temple casts.
			// BUGFIX: parameter2 on opcode 18 is the modifier TYPE, not a
			// duration/permanence flag -- confirmed via IESDP. parameter2=2
			// means "percentage", so this was applying "-8% of max HP" per
			// cast instead of a flat -8, and (independently of the opcode
			// 101 fix above) never behaved as the "-8 permanent" comment
			// intended. parameter2=0 is cumulative/flat, matching the
			// original intent of a flat, stacking-per-cast penalty.
			PATCH_IF (~%res_spell%~ STRING_EQUAL_CASE ~CLERIC_RESURRECTION~) BEGIN
				LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 18 target = 1 power = 0 parameter1 = (0 - 8) parameter2 = 0 timing = 4 duration = 2 resist_dispel = 0 probability1 = 100 END
			END

			// (4) Set raised creature to 1 HP
			LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 17 target = 2 power = 7 parameter1 = 1 parameter2 = 1 timing = 4 duration = 1 resist_dispel = 0 probability1 = 100 END
		BUT_ONLY
	END
END	
// SPJA01 (fixed from a typo, "SPPRJA01", which never matched any real
// resource in this game -- confirmed via CHITIN.KEY lookup -- so this
// entire patch silently no-op'd for it since day one. SPJA01 is
// Stratagems' own name, per its resurrection.tpa, for a "Raise Dead not
// cast by a temple" spell variant.) Keeps the full effect set, CON
// penalty included, same as the main temple-cast spells above.
ACTION_IF FILE_EXISTS_IN_GAME ~SPJA01.spl~ BEGIN
	COPY_EXISTING ~SPJA01.SPL~ ~override~
		READ_STRREF 0x50 ~desc~
		SAY 0x50 @6
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 17 target = 2 power = 7 parameter1 = 100 parameter2 = 2 timing = 1 resist_dispel = 0 probability1 = 100 END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 265 target = 3 power = 0 parameter1 = 1 parameter2 = 0 timing = 1 resist_dispel = 0 probability1 = 100 insert_point = 1 STR_VAR resource = ~EJRAISED~ END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 265 target = 1 power = 0 parameter1 = 1 parameter2 = 0 timing = 1 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJRAISED~ END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 265 target = 1 power = 0 parameter1 = 1 parameter2 = 0 timing = 4 duration = 2 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJRAISED~ END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 17 target = 2 power = 7 parameter1 = 1 parameter2 = 1 timing = 4 duration = 1 resist_dispel = 0 probability1 = 100 END
	BUT_ONLY
END

// spwish10 (the Wish spell's own "bring back a companion" option) gets the
// heal and set-to-1-HP effects but deliberately NOT the CON penalty, per
// the user's explicit request: Wish is meant to be strictly more powerful
// than ordinary Raise Dead/Resurrection, bypassing their usual costs and
// penalties entirely (matching classic D&D Wish lore -- it supersedes even
// a target's own refusal to be raised, which plain Resurrection does not).
ACTION_IF FILE_EXISTS_IN_GAME ~spwish10.spl~ BEGIN
	COPY_EXISTING ~spwish10.SPL~ ~override~
		READ_STRREF 0x50 ~desc~
		SAY 0x50 @603
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 17 target = 2 power = 7 parameter1 = 100 parameter2 = 2 timing = 1 resist_dispel = 0 probability1 = 100 END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 17 target = 2 power = 7 parameter1 = 1 parameter2 = 1 timing = 4 duration = 1 resist_dispel = 0 probability1 = 100 END
	BUT_ONLY
END

// -----------------------------------------------------------------------------
// Raise Dead's -1 CON penalty, applied AFTER revival. Effects aimed at the
// dead target in the raise spell itself are lost when it is revived (the
// GitHub version's own notes say a target penalty could never be made to
// stick). So Raise Dead only sets the global EJRAISED (see above); this
// script notices each companion going from dead to alive in the party and,
// if EJRAISED is set, gives them EJRDCON (-1 CON for 2 in-game weeks).
// Components 600/700 apply EJRDCON themselves for their own revivals.
// -----------------------------------------------------------------------------
<<<<<<<< npc-inline/ejcon.baf
>>>>>>>>
OUTER_SET ejc_constr = RESOLVE_STR_REF (~Raise Dead: -1 Constitution for two weeks.~)
COPY ~npc-inline/ejcon.baf~ ~weidu_external/npc-bodies/ejcon.baf~
ACTION_IF FILE_EXISTS ~weidu_external/npc-bodies/NPCbods.2da~ BEGIN
	COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
		COUNT_2DA_ROWS 9 ejc_rows
	OUTER_FOR (ejc_r = 1; ejc_r < ejc_rows; ++ejc_r) BEGIN
		COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
			READ_2DA_ENTRY ejc_r 0 9 ejc_ind
			READ_2DA_ENTRY ejc_r 1 9 ejc_dv
		ACTION_IF NOT VARIABLE_IS_SET $EJC_SEEN(~%ejc_ind%~) BEGIN
			OUTER_SET $EJC_SEEN(~%ejc_ind%~) = 1
			APPEND_OUTER ~weidu_external/npc-bodies/ejcon.baf~ ~~~~~
IF
	InPartyAllowDead("%ejc_dv%")
	Dead("%ejc_dv%")
	!Global("EJwd%ejc_ind%","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJwd%ejc_ind%","GLOBAL",1)
END
IF
	Global("EJwd%ejc_ind%","GLOBAL",1)
	Global("EJRESD","GLOBAL",1)
	InParty("%ejc_dv%")
	!Dead("%ejc_dv%")
THEN
	RESPONSE #100
		SetGlobal("EJwd%ejc_ind%","GLOBAL",0)
		SetGlobal("EJRESD","GLOBAL",0)
		SetGlobal("EJRDs%ejc_ind%_1","GLOBAL",0)
		SetGlobal("EJRDs%ejc_ind%_2","GLOBAL",0)
		SetGlobal("EJRDs%ejc_ind%_3","GLOBAL",0)
		SetGlobal("EJRDs%ejc_ind%_4","GLOBAL",0)
		SetGlobal("EJRDs%ejc_ind%_5","GLOBAL",0)
		ApplySpellRES("EJRDR1","%ejc_dv%")
		ApplySpellRES("EJRDR2","%ejc_dv%")
		ApplySpellRES("EJRDR3","%ejc_dv%")
		ApplySpellRES("EJRDR4","%ejc_dv%")
		ApplySpellRES("EJRDR5","%ejc_dv%")
END
IF
	Global("EJwd%ejc_ind%","GLOBAL",1)
	Global("EJRAISED","GLOBAL",1)
	InParty("%ejc_dv%")
	!Dead("%ejc_dv%")
THEN
	RESPONSE #100
		SetGlobal("EJwd%ejc_ind%","GLOBAL",0)
		SetGlobal("EJRAISED","GLOBAL",0)
		SetGlobal("EJRDq%ejc_ind%","GLOBAL",1)
END
IF
	Global("EJwd%ejc_ind%","GLOBAL",1)
	InParty("%ejc_dv%")
	!Dead("%ejc_dv%")
THEN
	RESPONSE #100
		SetGlobal("EJwd%ejc_ind%","GLOBAL",0)
END~~~~~
			// Stack manager: EJRDq<ind> = 1 asks for one more -1 CON stack.
			OUTER_FOR (ejrd_j = 1; ejrd_j <= 5; ++ejrd_j) BEGIN
				APPEND_OUTER ~weidu_external/npc-bodies/ejcon.baf~ ~~~~~
IF
	Global("EJRDq%ejc_ind%","GLOBAL",1)
	Global("EJRDs%ejc_ind%_%ejrd_j%","GLOBAL",0)
	InParty("%ejc_dv%")
	!Dead("%ejc_dv%")
THEN
	RESPONSE #100
		SetGlobal("EJRDq%ejc_ind%","GLOBAL",0)
		SetGlobal("EJRDs%ejc_ind%_%ejrd_j%","GLOBAL",1)
		SetGlobalTimer("EJRDt%ejc_ind%_%ejrd_j%","GLOBAL",100800)
		ApplySpellRES("EJRDC%ejrd_j%","%ejc_dv%")
		DisplayStringHead("%ejc_dv%",%ejc_constr%)
END~~~~~
			END
			APPEND_OUTER ~weidu_external/npc-bodies/ejcon.baf~ ~~~~~
IF
	Global("EJRDq%ejc_ind%","GLOBAL",1)
	InParty("%ejc_dv%")
	!Dead("%ejc_dv%")
THEN
	RESPONSE #100
		SetGlobal("EJRDq%ejc_ind%","GLOBAL",0)
END~~~~~
			OUTER_FOR (ejrd_j = 1; ejrd_j <= 5; ++ejrd_j) BEGIN
				APPEND_OUTER ~weidu_external/npc-bodies/ejcon.baf~ ~~~~~
IF
	Global("EJRDs%ejc_ind%_%ejrd_j%","GLOBAL",1)
	GlobalTimerExpired("EJRDt%ejc_ind%_%ejrd_j%","GLOBAL")
	!Dead("%ejc_dv%")
THEN
	RESPONSE #100
		SetGlobal("EJRDs%ejc_ind%_%ejrd_j%","GLOBAL",0)
		ApplySpellRES("EJRDR%ejrd_j%","%ejc_dv%")
END~~~~~
			END
		END
	END
END
APPEND_OUTER ~weidu_external/npc-bodies/ejcon.baf~ ~~~~~
IF
	OR(2)
		Global("EJRAISED","GLOBAL",1)
		Global("EJRESD","GLOBAL",1)
	!Global("EJRAISEDa","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJRAISEDa","GLOBAL",1)
		SetGlobalTimer("EJRAISEDt","GLOBAL",30)
END
IF
	Global("EJRAISEDa","GLOBAL",1)
	GlobalTimerExpired("EJRAISEDt","GLOBAL")
THEN
	RESPONSE #100
		SetGlobal("EJRAISED","GLOBAL",0)
		SetGlobal("EJRESD","GLOBAL",0)
		SetGlobal("EJRAISEDa","GLOBAL",0)
END~~~~~
ACTION_FOR_EACH ejc_baldur IN ~baldur~ ~bdbaldur~ ~baldur25~ BEGIN
	ACTION_IF (FILE_EXISTS_IN_GAME ~%ejc_baldur%.bcs~) BEGIN
		EXTEND_BOTTOM ~%ejc_baldur%.bcs~ ~weidu_external/npc-bodies/ejcon.baf~
	END
END

BEGIN @300 // Progressive price for Raise Dead spell
DESIGNATED 300
COPY ~npc-bodies/2da/RAISDEAD.2DA~ ~override/RAISDEAD.2DA~

BEGIN @400 // Time limits for Raise Dead and similar spells
DESIGNATED 400
ACTION_IF !(FILE_EXISTS ~weidu_external/npc-bodies/NPCbods.2da~) BEGIN
	<<<<<<<< npc-inline/NPCbods.2da
	2DA V1.0 
	INDEX	DV	CRE	NAME	SCRIPT	RACE	GENDER	WEIGHT
	0		#	#	#		#		#		#		#
	>>>>>>>> 

	COPY ~npc-inline/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~ 
	LAM JOINABLE_NPC_ARRAYS
	OUTER_SET bind = 1
	ACTION_PHP_EACH JOINABLE_NPC_ARRAY AS cre => dv BEGIN
		OUTER_SET ind = 0
		OUTER_SET skip = 0
		COPY_EXISTING ~%cre%~ ~override~
			READ_STRREF 0x8 name
			READ_BYTE  0x272 race
			READ_ASCII 0x248 script
			READ_BYTE 0x275 gender
			READ_BYTE 0x271 general
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Ajantis~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 182
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Alora~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 42
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Branwen~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 118
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Coran~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 106
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Dorn~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 182
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Dynaheir~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 106 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Edwin~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 134 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Eldoth~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 176 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Faldorn~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 112 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Garrick~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 106 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Imoen~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 94 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Jaheira~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 105 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Kagain~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 160 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Khalid~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 130 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Kivan~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 122 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Minsc~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 188 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Montaron~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 70 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Neera~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 89 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Quayle~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 66 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Rasaad~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 176 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Safana~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 118 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Shar-Teel~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 148 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Skie~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 106 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Tiax~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 69 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Viconia~) BEGIN
					TEXT_SPRINT body ~DEADFEMA~
					SET weight = 110 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Xan~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 102 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Xsar~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 164 
				END ELSE
				PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Yeslick~) BEGIN
					TEXT_SPRINT body ~DEADMALE~
					SET weight = 155 
				END ELSE
				PATCH_IF gender = 1 BEGIN //male
					TEXT_SPRINT body ~DEADMALE~
					PATCH_IF race = 1 BEGIN //human
						SET weight = RANDOM(130 220) 
					END ELSE
					PATCH_IF race = 2 BEGIN //elf
						SET weight = RANDOM(110 195) 
					END ELSE
					PATCH_IF race = 3 BEGIN //half-elf
						SET weight = RANDOM(120 210) 
					END ELSE
					PATCH_IF race = 4 BEGIN //dwarf
						SET weight = RANDOM(130 190) 
					END ELSE
					PATCH_IF race = 5 BEGIN //halfling
						SET weight = RANDOM(40 75) 
					END ELSE
					PATCH_IF race = 6 BEGIN //gnome
						SET weight = RANDOM(35 65) 
					END ELSE
					PATCH_IF race = 7 BEGIN //half orc
						SET weight = RANDOM(170 250) 
					END ELSE
						SET weight = RANDOM(130 210) //any other race if used for some reason
				END ELSE
				TEXT_SPRINT body ~DEADFEMA~ //all other genders, presumably female most of the time
				PATCH_IF race = 1 BEGIN //human
					SET weight = RANDOM(110 170) 
				END ELSE
				PATCH_IF race = 2 BEGIN //elf
					SET weight = RANDOM(105 165) 
				END ELSE
					PATCH_IF race = 3 BEGIN //half-elf
					SET weight = RANDOM(110 180) 
				END ELSE
				PATCH_IF race = 4 BEGIN //dwarf
					SET weight = RANDOM(110 175) 
				END ELSE
				PATCH_IF race = 5 BEGIN //halfling
					SET weight = RANDOM(30 55) 
				END ELSE
				PATCH_IF race = 6 BEGIN //gnome
					SET weight = RANDOM(25 55) 
				END ELSE
				PATCH_IF race = 7 BEGIN //half orc
					SET weight = RANDOM(160 205) 
				END ELSE
				SET weight = RANDOM(110 195) //any other race if used for some reason
				
		OUTER_INNER_PATCH_SAVE name ~%name%~ BEGIN
				REPLACE_TEXTUALLY ~ ~ ~_~
		END		
		ACTION_IF (~%script%~ STRING_EQUAL_CASE ~none~) BEGIN
			OUTER_SET skip = 1
		END	
		ACTION_IF (~%script%~ STRING_EQUAL_CASE ~~) BEGIN
			OUTER_SET skip = 1
		END
		// Skip undead (race 125) - vampires and other undead don't drop bodies
		ACTION_IF (race = 125) BEGIN
			OUTER_SET skip = 1
		END
		COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
			COUNT_2DA_COLS cols
			READ_2DA_ENTRIES_NOW ~r2en_bods~ cols
			FOR (row = 0; row < r2en_bods; ++row) BEGIN
				READ_2DA_ENTRY_FORMER ~r2en_bods~ row 0 prev_ind
				READ_2DA_ENTRY_FORMER ~r2en_bods~ row 1 prev_dv
				READ_2DA_ENTRY_FORMER ~r2en_bods~ row 4 prev_script
				READ_2DA_ENTRY_FORMER ~r2en_bods~ row 7 prev_weight
				PATCH_IF (skip = 0) BEGIN
					PATCH_IF (~%dv%~ STRING_EQUAL_CASE ~%prev_dv%~) BEGIN
						SET ind = prev_ind
						SET weight = prev_weight					
						PATCH_IF (~%script%~ STRING_EQUAL_CASE ~%prev_script%~) BEGIN
							SET skip = 1
						END	
					END
				END
			END
			
		ACTION_IF (ind = 0) BEGIN
				OUTER_SET ind = bind
				OUTER_SET bind += 1	
		END
			
		ACTION_IF (skip = 0)	BEGIN
			APPEND_OUTER ~weidu_external/npc-bodies/NPCbods.2da~ ~%ind% %dv%	%cre%	%name%	%script%	%race%	%gender% %weight% %general%~
		END
	END
END	

ACTION_IF (MOD_IS_INSTALLED "npc-bodies.TP2" 100) BEGIN
	COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
		COUNT_2DA_COLS cols
		READ_2DA_ENTRIES_NOW ~r2en_bods~ cols
		FOR (row = 0; row < r2en_bods; ++row) BEGIN
