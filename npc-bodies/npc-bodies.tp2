			SetGlobal("EJNOREV%ind%","GLOBAL",0)~~~~~    //string that the pattern will be replaced with
							END
						END
				END
				ACTION_FOR_EACH baldur IN ~baldur~ ~bdbaldur~ ~baldur25~ BEGIN
