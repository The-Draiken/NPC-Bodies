// =============================================================================
// Component 800: Diamonds required for Resurrection (needs Stratagems 4130)
// Included from npc-bodies.tp2; each subcomponent sets ejd_count (0-5) first.
//
// Stratagems' version only checks PartyHasItem("misc42") and then takes the
// diamond with TakePartyItem, which removes a whole inventory slot -- so a
// stack of diamonds is eaten in one go, and its ini setting is only read as
// on/off (any number = one diamond check). This replaces it:
//   - NumItemsPartyGT counts diamonds across stacks;
//   - TakePartyItemNum takes exactly the required number, and only when the
//     party has enough;
//   - with too few, the cast is stopped (Stratagems' own method) and nothing
//     is taken;
//   - only party casters pay; NPC casters are not charged party diamonds;
//   - temple services still need no diamonds (they never ran this check).
// 0 diamonds removes the requirement entirely.
// =============================================================================

<<<<<<<< npc-inline/ejdiam_empty.baf
>>>>>>>>

OUTER_SET ejd_m1 = ejd_count - 1
OUTER_SET ejd_fail = RESOLVE_STR_REF (~This spell requires %ejd_count% diamond(s) to cast. The party has too few, so the spell is lost.~)

// Remove Stratagems' single-diamond check from Resurrection (and the Bhaalspawn
// version), whatever this component's setting is.
LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~CLERIC_RESURRECTION~ RET spell_res END
OUTER_SPRINT ejd_res ~%spell_res%~

ACTION_FOR_EACH ejd_spell IN ~%ejd_res%~ ~BHAAL4A~ BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%ejd_spell%.spl~ BEGIN
		COPY_EXISTING ~%ejd_spell%.spl~ ~override~
			LPF DELETE_EFFECT INT_VAR check_headers = 1 check_globals = 1 match_opcode = 177 STR_VAR match_resource = ~dw#diamo~ END
			LPF DELETE_EFFECT INT_VAR check_headers = 1 check_globals = 1 match_opcode = 177 STR_VAR match_resource = ~EJDIAM~ END
		BUT_ONLY
	END
END

ACTION_IF (ejd_count > 0) BEGIN
	// The invisible checker creature and its script.
	COPY ~npc-bodies/cre/BODYDROP.CRE~ ~override/EJDIAM.cre~
		WRITE_ASCII 0x280 ~EJDIAM~ (32)
		WRITE_ASCII 0x248 ~EJDIAM~ (8)

	COPY ~npc-inline/ejdiam_empty.baf~ ~weidu_external/npc-bodies/EJDIAM.baf~
	APPEND_OUTER ~weidu_external/npc-bodies/EJDIAM.baf~ ~~~~~
IF
	!InParty(LastSummonerOf(Myself))
THEN
	RESPONSE #100
		DestroySelf()
END
IF
	NumItemsPartyGT("misc42",%ejd_m1%)
THEN
	RESPONSE #100
		TakePartyItemNum("misc42",%ejd_count%)
		DestroyItem("misc42")
		DestroySelf()
END
IF
	True()
THEN
	RESPONSE #100
		ActionOverride(LastSummonerOf(Myself),ReallyForceSpell(Myself,DO_NOTHING))
		DisplayString(LastSummonerOf(Myself),%ejd_fail%)
		DestroySelf()
END~~~~~
	COMPILE ~weidu_external/npc-bodies/EJDIAM.baf~

	// The summon effect (no summoning animation), as Stratagems does it.
	CREATE ~EFF~ ~EJDIAM~
		WRITE_LONG 0x10 67
		WRITE_LONG 0x14 1
		WRITE_LONG 0x18 9
		WRITE_LONG 0x1c 0
		WRITE_LONG 0x20 0
		WRITE_LONG 0x24 1
		WRITE_LONG 0x28 6
		WRITE_SHORT 0x2c 100
		WRITE_SHORT 0x2e 0
		WRITE_ASCII 0x30 ~EJDIAM~ (8)
		WRITE_ASCII 0x70 ~NONE~ (8)

	ACTION_FOR_EACH ejd_spell IN ~%ejd_res%~ ~BHAAL4A~ BEGIN
		ACTION_IF FILE_EXISTS_IN_GAME ~%ejd_spell%.spl~ BEGIN
			COPY_EXISTING ~%ejd_spell%.spl~ ~override~
				LPF ADD_SPELL_CFEFFECT INT_VAR opcode = 177 target = 1 power = 9 parameter1 = 0 parameter2 = 3 timing = 0 duration = 60 probability1 = 100 STR_VAR resource = ~EJDIAM~ END
				READ_STRREF 0x50 ejd_desc
				INNER_PATCH_SAVE ejd_desc ~%ejd_desc%~ BEGIN
					REPLACE_TEXTUALLY ~This spell requires a diamond as a material component\.~ ~~
				END
				SAY 0x50 ~%ejd_desc%

Material component: %ejd_count% diamond(s), taken from the party's inventory (stacks count). If the party has fewer, the spell fails and no diamonds are used. Temple services need no diamonds.~
			BUT_ONLY
		END
	END
END ELSE BEGIN
	// No diamonds: just strip Stratagems' sentence from the description.
	ACTION_FOR_EACH ejd_spell IN ~%ejd_res%~ ~BHAAL4A~ BEGIN
		ACTION_IF FILE_EXISTS_IN_GAME ~%ejd_spell%.spl~ BEGIN
			COPY_EXISTING ~%ejd_spell%.spl~ ~override~
				READ_STRREF 0x50 ejd_desc
				INNER_PATCH_SAVE ejd_desc ~%ejd_desc%~ BEGIN
					REPLACE_TEXTUALLY ~This spell requires a diamond as a material component\.~ ~~
				END
				SAY 0x50 ~%ejd_desc%~
			BUT_ONLY
		END
	END
END
