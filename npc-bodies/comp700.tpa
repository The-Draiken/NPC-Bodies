// =============================================================================
// Component 700: Player-Created Character Revival [EXPERIMENTAL]
// Included from npc-bodies.tp2 (BEGIN @700).
//
// Joinable NPCs are reached by their unique script names. Player-created
// characters have none, and testing showed that a dead creature outside the
// party does not run its own script either. Design (version 5), based on how
// Animate Dead Now's Gift of Life reaches corpses:
//
//   - Registration gives each created character permanent spell states
//     (EJPC_ANY, EJPC_<k>) AND a permanent repeating effect (opcode 272,
//     timing 9 = survives death). A dead body keeps firing that effect.
//   - Each pulse, while the body is dead, makes the BODY summon its own
//     helper creature EJPR<k> (opcode 67). The helper's script refers to the
//     body as LastSummonerOf -- a handle on that exact body, no name needed.
//   - The helper does nothing and vanishes unless a priest or the genie has
//     asked for something. Then it does what Component 600's watcher does
//     for companions: collects the body into a temple's care, or casts Raise
//     Dead / Resurrection on it and puts the revived character back in the
//     party.
//   - The body only pulses where its area is loaded, i.e. where the party is,
//     so requests made somewhere else time out (gold is refunded).
//
// Per-number globals (k = 1..ejp_max):
//   EJPCok<k>    1 = registered (own script confirmed)
//   EJPCst<k>    0 untracked, 1 in party, 2 rejoined after chunking,
//                3 out of party, 4 in temple care
//   EJPCdead<k>  1 = died (not chunked) and not yet revived
//   EJPCchunk<k> 1 = permanently dead (chunked etc.)
//   EJPCcare<k>  number of the priest whose temple holds the body
//   EJPCrev<k>   revival requested: 1 Raise Dead, 2 Resurrection
//   EJPCbusy<k>  1 = a helper has cast the revival and is waiting
//   EJPCpaid<k>  gold paid (refunded on failure)
//   EJPCcol<k>   1 = a priest asked to collect a dismissed body
//   timers: EJPCto<k> (revival), EJPCcolT<k> (collection), EJPCrj<k>
// Shared: EJPCnext, EJPCpend, EJPCwait, EJPCslot<N>, EJPChand, EJPChandP,
//   EJPChandT (registration and temple hand-over bookkeeping).
// =============================================================================

<<<<<<<< npc-inline/ejp_empty.baf
>>>>>>>>

OUTER_SET ejp_max = 8
OUTER_SET ejp_raise_cost = 5000
OUTER_SET ejp_res_cost = 10000
OUTER_SET ejp_raise_m1 = ejp_raise_cost - 1
OUTER_SET ejp_res_m1 = ejp_res_cost - 1
OUTER_SET ejp_pulse = 6

OUTER_SET ejp_fail_str = RESOLVE_STR_REF (~The body was not found here. Any gold paid has been returned.~)
OUTER_SET ejp_spellfail_str = RESOLVE_STR_REF (~The revival spell failed to take hold. Any gold paid has been returned.~)
OUTER_SET ejp_nocol_str = RESOLVE_STR_REF (~The priests searched, but the body was not found in this area.~)
OUTER_SET ejp_constr = RESOLVE_STR_REF (~Raise Dead: -1 Constitution for two weeks.~)

LAF ADD_IDS_ENTRY INT_VAR minValue = 1 maxValue = 255 STR_VAR idsFile = ~SPLSTATE~ identifier = ~EJPC_ANY~ RET value END
ACTION_IF (value < 0) BEGIN
	FAIL ~NPC Bodies 700: no free SPLSTATE.IDS value for EJPC_ANY.~
END
OUTER_SET ejp_any = value

// -----------------------------------------------------------------------------
// Per-number resources.
// -----------------------------------------------------------------------------
OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
	LAF ADD_IDS_ENTRY INT_VAR minValue = 1 maxValue = 255 STR_VAR idsFile = ~SPLSTATE~ identifier = ~EJPC_%k%~ RET value END
	ACTION_IF (value < 0) BEGIN
		FAIL ~NPC Bodies 700: no free SPLSTATE.IDS value for EJPC_%k%.~
	END
	OUTER_SET $EJP_SS(~%k%~) = value
	OUTER_SET ejp_ssk = value
	OUTER_SET $EJP_REG(~%k%~) = RESOLVE_STR_REF (~Registered for NPC Bodies revival as fallen companion #%k%.~)
	OUTER_SET $EJP_CARE(~%k%~) = RESOLVE_STR_REF (~Fallen companion #%k% is now in this temple's care.~)

	// EJPCY<k>.EFF: the summon itself. Done through an EFF file (opcode 177)
	// so the summoning animation can be switched off (resource 2 = NONE),
	// exactly as Stratagems does for its invisible dw#diamo helper. Without
	// this, every pulse showed a puff of smoke.
	CREATE ~EFF~ ~EJPCY%k%~
		WRITE_LONG 0x10 67
		WRITE_LONG 0x14 1
		WRITE_LONG 0x18 9
		WRITE_LONG 0x1c 0
		WRITE_LONG 0x20 0
		WRITE_LONG 0x24 1
		WRITE_LONG 0x28 6
		WRITE_SHORT 0x2c 100
		WRITE_SHORT 0x2e 0
		WRITE_ASCII 0x30 ~EJPR%k%~ (8)
		WRITE_ASCII 0x70 ~NONE~ (8)

	// EJPCX<k>: makes the body summon its helper (via EJPCY<k>).
	COPY ~npc-bodies/For Temples/EJTRD.SPL~ ~override/EJPCX%k%.spl~
		LPF ~DELETE_SPELL_EFFECT~ INT_VAR opcode_to_delete = "-1" END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 177 target = 2 power = 0 parameter1 = 0 parameter2 = 2 timing = 1 duration = 0 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJPCY%k%~ END

	// EJPCW<k>.EFF: the repeating pulse. Applies EJPCX<k> only while the body
	// is dead (SPLPROT row 138 = STATEBITS contains n; n = STATE_REALLY_DEAD).
	CREATE ~EFF~ ~EJPCW%k%~
		WRITE_LONG 0x10 326
		WRITE_LONG 0x14 2
		WRITE_LONG 0x1c 0xFC0
		WRITE_LONG 0x20 138
		WRITE_LONG 0x24 1
		WRITE_LONG 0x28 0
		WRITE_SHORT 0x2c 100
		WRITE_SHORT 0x2e 0
		WRITE_ASCII 0x30 ~EJPCX%k%~ (8)

	// EJPCR<k>: registration -- both spell states plus the repeating pulse.
	COPY ~npc-bodies/For Temples/EJTRD.SPL~ ~override/EJPCR%k%.spl~
		LPF ~DELETE_SPELL_EFFECT~ INT_VAR opcode_to_delete = "-1" END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 328 target = 2 power = 0 parameter1 = 0 parameter2 = ejp_any timing = 9 duration = 0 resist_dispel = 0 probability1 = 100 special = 1 END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 328 target = 2 power = 0 parameter1 = 0 parameter2 = ejp_ssk timing = 9 duration = 0 resist_dispel = 0 probability1 = 100 special = 1 END
		LPF ~ADD_SPELL_EFFECT~ INT_VAR opcode = 272 target = 2 power = 0 parameter1 = ejp_pulse parameter2 = 3 timing = 9 duration = 0 resist_dispel = 0 probability1 = 100 STR_VAR resource = ~EJPCW%k%~ END

	COPY ~npc-bodies/itm/DEADMALE.ITM~ ~override/EJPB%k%.itm~
		SAY NAME1 ~Remains of fallen companion #%k%~
		SAY NAME2 ~Remains of fallen companion #%k%~
		SAY UNIDENTIFIED_DESC ~The body of a fallen adventurer, registered as fallen companion #%k%. With it, Raise Dead can return them to life.~
		SAY DESC ~The body of a fallen adventurer, registered as fallen companion #%k%. With it, Raise Dead can return them to life.~
		WRITE_LONG 0x4c 150

	// EJPD<k>: scriptless helper that drops / removes the body item.
	COPY ~npc-bodies/cre/BODYDROP.CRE~ ~override/EJPD%k%.cre~
		WRITE_ASCII 0x280 ~EJPD%k%~ (32)
		WRITE_LONG 0x248 0
		WRITE_LONG 0x24c 0
	// EJPR<k>: the helper summoned by the body (script EJPR<k>.bcs).
	COPY ~npc-bodies/cre/BODYDROP.CRE~ ~override/EJPR%k%.cre~
		WRITE_ASCII 0x280 ~EJPR%k%~ (32)
		WRITE_ASCII 0x248 ~EJPR%k%~ (8)
END

// -----------------------------------------------------------------------------
// Helper script EJPR<k>: LastSummonerOf = the dead body that summoned it.
// -----------------------------------------------------------------------------
OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
	OUTER_SET care = $EJP_CARE(~%k%~)
	COPY ~npc-inline/ejp_empty.baf~ ~weidu_external/npc-bodies/EJPR%k%.baf~
	APPEND_OUTER ~weidu_external/npc-bodies/EJPR%k%.baf~ ~~~~~
IF
	Global("EJPCbusy%k%","GLOBAL",1)
	!Global("EJPCcaster","LOCALS",1)
THEN
	RESPONSE #100
		DestroySelf()
END
IF
	Global("EJPCbusy%k%","GLOBAL",0)
	Global("EJPCcaster","LOCALS",1)
THEN
	RESPONSE #100
		DestroySelf()
END
// Chunk-rejoin, every time (not just the first): the body was pushed out of
// the party by a permanent death -- it was not dismissed alive (EJPCout = 0)
// and had not been lying dead in the party for more than a few seconds
// (EJPCarm / EJPCdipT), which is what a deliberate dismissal looks like.
IF
	!InPartyAllowDead(LastSummonerOf)
	StateCheck(LastSummonerOf,STATE_PERMANENT_DEATH)
	!Global("EJPCst%k%","GLOBAL",4)
	Global("EJPCout%k%","GLOBAL",0)
	OR(2)
		Global("EJPCarm%k%","GLOBAL",0)
		!GlobalTimerExpired("EJPCdipT%k%","GLOBAL")
THEN
	RESPONSE #100
		SetGlobal("EJPCarm%k%","GLOBAL",0)
		SetGlobal("EJPCst%k%","GLOBAL",2)
		SetGlobal("EJPCchunk%k%","GLOBAL",1)
		ChangeGeneral(LastSummonerOf,DEAD)
		ActionOverride(LastSummonerOf,JoinParty())
		DestroySelf()
END
IF
	Global("EJPCcol%k%","GLOBAL",1)
	!InPartyAllowDead(LastSummonerOf)
THEN
	RESPONSE #100
		SetGlobal("EJPCcol%k%","GLOBAL",0)
		SetGlobal("EJPCcare%k%","GLOBAL",0)
		AddGlobals("EJPCcare%k%","EJPChandP")
		SetGlobal("EJPCst%k%","GLOBAL",4)
		DisplayStringHead(LastSummonerOf,%care%)
		DestroySelf()
END
IF
	Global("EJPCrev%k%","GLOBAL",1)
	Global("EJPCbusy%k%","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("EJPCbusy%k%","GLOBAL",1)
		SetGlobal("EJPCcaster","LOCALS",1)
		ChangeGeneral(LastSummonerOf,DEAD)
		ReallyForceSpellDead(LastSummonerOf,CLERIC_RAISE_DEAD)
END
IF
	Global("EJPCrev%k%","GLOBAL",2)
	Global("EJPCbusy%k%","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("EJPCbusy%k%","GLOBAL",1)
		SetGlobal("EJPCcaster","LOCALS",1)
		ChangeGeneral(LastSummonerOf,DEAD)
		ReallyForceSpellDead(LastSummonerOf,CLERIC_RESURRECTION)
END
IF
	Global("EJPCbusy%k%","GLOBAL",1)
	Global("EJPCcaster","LOCALS",1)
	Global("EJPCrev%k%","GLOBAL",2)
	!StateCheck(LastSummonerOf,STATE_DEAD)
THEN
	RESPONSE #100
		SetGlobal("EJPCrev%k%","GLOBAL",4)
		SetGlobal("EJRESD","GLOBAL",0)
		SetGlobal("EJRDsP%k%_1","GLOBAL",0)
		SetGlobal("EJRDsP%k%_2","GLOBAL",0)
		SetGlobal("EJRDsP%k%_3","GLOBAL",0)
		SetGlobal("EJRDsP%k%_4","GLOBAL",0)
		SetGlobal("EJRDsP%k%_5","GLOBAL",0)
		ApplySpellRES("EJRDR1",LastSummonerOf)
		ApplySpellRES("EJRDR2",LastSummonerOf)
		ApplySpellRES("EJRDR3",LastSummonerOf)
		ApplySpellRES("EJRDR4",LastSummonerOf)
		ApplySpellRES("EJRDR5",LastSummonerOf)
END
IF
	Global("EJPCbusy%k%","GLOBAL",1)
	Global("EJPCcaster","LOCALS",1)
	Global("EJPCrev%k%","GLOBAL",1)
	!StateCheck(LastSummonerOf,STATE_DEAD)
THEN
	RESPONSE #100
		SetGlobal("EJPCrev%k%","GLOBAL",3)
		SetGlobal("EJRAISED","GLOBAL",0)
		SetGlobal("EJRDqP%k%","GLOBAL",1)
END
IF
	Global("EJPCbusy%k%","GLOBAL",1)
	Global("EJPCcaster","LOCALS",1)
	!StateCheck(LastSummonerOf,STATE_DEAD)
THEN
	RESPONSE #100
		SetGlobal("EJPCbusy%k%","GLOBAL",0)
		SetGlobal("EJPCrev%k%","GLOBAL",0)
		SetGlobal("EJPCpaid%k%","GLOBAL",0)
		SetGlobal("EJPCcare%k%","GLOBAL",0)
		SetGlobal("EJPCdead%k%","GLOBAL",0)
		SetGlobal("EJPCchunk%k%","GLOBAL",0)
		SetGlobal("EJPCst%k%","GLOBAL",1)
		ChangeGeneral(LastSummonerOf,HUMANOID)
		TakePartyItem("EJPB%k%")
		DestroyItem("EJPB%k%")
		ActionOverride(LastSummonerOf,JoinParty())
		DestroySelf()
END
IF
	Global("EJPCbusy%k%","GLOBAL",0)
	Global("EJPCrev%k%","GLOBAL",0)
	Global("EJPCcol%k%","GLOBAL",0)
THEN
	RESPONSE #100
		DestroySelf()
END~~~~~
	COMPILE ~weidu_external/npc-bodies/EJPR%k%.baf~
END

// -----------------------------------------------------------------------------
// The character's own override script, EJPCS<k>: only for things that happen
// while they are in the party (or in the instant they are pushed out).
// -----------------------------------------------------------------------------
OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
	OUTER_SET reg = $EJP_REG(~%k%~)
	OUTER_SET SS = $EJP_SS(~%k%~)
	OUTER_SET k1 = k + 1
	COPY ~npc-inline/ejp_empty.baf~ ~weidu_external/npc-bodies/EJPCS%k%.baf~
	APPEND_OUTER ~weidu_external/npc-bodies/EJPCS%k%.baf~ ~~~~~
IF
	!Global("EJPCok%k%","GLOBAL",1)
	CheckSpellState(Myself,%SS%)
THEN
	RESPONSE #100
		SetGlobal("EJPCok%k%","GLOBAL",1)
		SetGlobal("EJPCnext","GLOBAL",%k1%)
		SetGlobal("EJPCpend","GLOBAL",0)
		SetGlobal("EJPCst%k%","GLOBAL",1)
		DisplayStringHead(Myself,%reg%)
END
IF
	!InPartyAllowDead(Myself)
	StateCheck(Myself,STATE_PERMANENT_DEATH)
	OR(2)
		Global("EJPCst%k%","GLOBAL",1)
		Global("EJPCst%k%","GLOBAL",3)
	!Global("EJPCchunkrj%k%","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJPCchunkrj%k%","GLOBAL",1)
		SetGlobal("EJPCst%k%","GLOBAL",2)
		SetGlobal("EJPCchunk%k%","GLOBAL",1)
		ChangeGeneral(Myself,DEAD)
		JoinParty()
END
IF
	Global("EJPCst%k%","GLOBAL",4)
	!Global("EJPCbusy%k%","GLOBAL",1)
	InPartyAllowDead(Myself)
	StateCheck(Myself,STATE_DEAD)
THEN
	RESPONSE #100
		LeaveParty()
END
IF
	InPartyAllowDead(Myself)
	OR(3)
		Global("EJPCst%k%","GLOBAL",0)
		Global("EJPCst%k%","GLOBAL",3)
		Global("EJPCst%k%","GLOBAL",4)
	!StateCheck(Myself,STATE_DEAD)
THEN
	RESPONSE #100
		SetGlobal("EJPCst%k%","GLOBAL",1)
		SetGlobal("EJPCcare%k%","GLOBAL",0)
END
IF
	InPartyAllowDead(Myself)
	OR(2)
		Global("EJPCst%k%","GLOBAL",0)
		Global("EJPCst%k%","GLOBAL",3)
THEN
	RESPONSE #100
		SetGlobal("EJPCst%k%","GLOBAL",1)
END
IF
	InParty(Myself)
	Global("EJPCst%k%","GLOBAL",2)
	!StateCheck(Myself,STATE_DEAD)
THEN
	RESPONSE #100
		SetGlobal("EJPCst%k%","GLOBAL",1)
		SetGlobal("EJPCchunkrj%k%","GLOBAL",0)
END
IF
	StateCheck(Myself,STATE_DEAD)
	!StateCheck(Myself,STATE_PERMANENT_DEATH)
	Global("EJPCdead%k%","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("EJPCdead%k%","GLOBAL",1)
		SaveObjectLocation("MYAREA","EJPCcorpse%k%",Myself)
		CreateCreatureAtLocation("EJPCcorpse%k%","MYAREA","EJPD%k%")
		ActionOverride("EJPD%k%",CreateItem("EJPB%k%",0,0,0))
		ActionOverride("EJPD%k%",DropItem("EJPB%k%",[-1.-1]))
		ActionOverride("EJPD%k%",DestroySelf())
END
IF
	InPartyAllowDead(Myself)
	StateCheck(Myself,STATE_PERMANENT_DEATH)
	Global("EJPCchunk%k%","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("EJPCchunk%k%","GLOBAL",1)
END
IF
	InParty(Myself)
	!StateCheck(Myself,STATE_DEAD)
	!Global("EJPCbusy%k%","GLOBAL",1)
	Global("EJRESD","GLOBAL",1)
	OR(2)
		Global("EJPCdead%k%","GLOBAL",1)
		Global("EJPCchunk%k%","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJRESD","GLOBAL",0)
		SetGlobal("EJRAISED","GLOBAL",0)
		SetGlobal("EJRDsP%k%_1","GLOBAL",0)
		SetGlobal("EJRDsP%k%_2","GLOBAL",0)
		SetGlobal("EJRDsP%k%_3","GLOBAL",0)
		SetGlobal("EJRDsP%k%_4","GLOBAL",0)
		SetGlobal("EJRDsP%k%_5","GLOBAL",0)
		ApplySpellRES("EJRDR1",Myself)
		ApplySpellRES("EJRDR2",Myself)
		ApplySpellRES("EJRDR3",Myself)
		ApplySpellRES("EJRDR4",Myself)
		ApplySpellRES("EJRDR5",Myself)
END
IF
	InParty(Myself)
	!StateCheck(Myself,STATE_DEAD)
	!Global("EJPCbusy%k%","GLOBAL",1)
	Global("EJRAISED","GLOBAL",1)
	OR(2)
		Global("EJPCdead%k%","GLOBAL",1)
		Global("EJPCchunk%k%","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJRAISED","GLOBAL",0)
		SetGlobal("EJRDqP%k%","GLOBAL",1)
END
IF
	InParty(Myself)
	!StateCheck(Myself,STATE_DEAD)
	!Global("EJPCbusy%k%","GLOBAL",1)
	OR(2)
		Global("EJPCdead%k%","GLOBAL",1)
		Global("EJPCchunk%k%","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJPCdead%k%","GLOBAL",0)
		SetGlobal("EJPCchunk%k%","GLOBAL",0)
		SetGlobal("EJPCchunkrj%k%","GLOBAL",0)
		ChangeGeneral(Myself,HUMANOID)
		CreateCreatureObject("EJPD%k%",Myself,0,0,0)
		ActionOverride("EJPD%k%",TakePartyItem("EJPB%k%"))
		ActionOverride("EJPD%k%",DestroyItem("EJPB%k%"))
		ActionOverride("EJPD%k%",DestroySelf())
END
IF
	InPartyAllowDead(Myself)
	StateCheck(Myself,STATE_DEAD)
	!StateCheck(Myself,STATE_PERMANENT_DEATH)
	!PartyHasItem("EJPB%k%")
	!General(Myself,EJNOBOD)
THEN
	RESPONSE #100
		ChangeGeneral(Myself,EJNOBOD)
END
IF
	InPartyAllowDead(Myself)
	StateCheck(Myself,STATE_DEAD)
	PartyHasItem("EJPB%k%")
	!General(Myself,DEAD)
THEN
	RESPONSE #100
		ChangeGeneral(Myself,DEAD)
END
IF
	StateCheck(Myself,STATE_PERMANENT_DEATH)
	!General(Myself,DEAD)
THEN
	RESPONSE #100
		ChangeGeneral(Myself,DEAD)
END
IF
	InPartyAllowDead(Myself)
	StateCheck(Myself,STATE_DEAD)
	Global("EJPCarm%k%","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("EJPCarm%k%","GLOBAL",1)
		SetGlobalTimer("EJPCdipT%k%","GLOBAL",6)
END
IF
	!StateCheck(Myself,STATE_DEAD)
	Global("EJPCarm%k%","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJPCarm%k%","GLOBAL",0)
END
IF
	!InPartyAllowDead(Myself)
	!StateCheck(Myself,STATE_DEAD)
	Global("EJPCout%k%","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("EJPCout%k%","GLOBAL",1)
END
IF
	InPartyAllowDead(Myself)
	Global("EJPCout%k%","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJPCout%k%","GLOBAL",0)
END~~~~~
	// Raise Dead CON stack manager (same as Component 200's for companions).
	OUTER_FOR (ejrd_j = 1; ejrd_j <= 5; ++ejrd_j) BEGIN
		APPEND_OUTER ~weidu_external/npc-bodies/EJPCS%k%.baf~ ~~~~~
IF
	Global("EJRDqP%k%","GLOBAL",1)
	Global("EJRDsP%k%_%ejrd_j%","GLOBAL",0)
	InParty(Myself)
	!StateCheck(Myself,STATE_DEAD)
THEN
	RESPONSE #100
		SetGlobal("EJRDqP%k%","GLOBAL",0)
		SetGlobal("EJRDsP%k%_%ejrd_j%","GLOBAL",1)
		SetGlobalTimer("EJRDtP%k%_%ejrd_j%","GLOBAL",100800)
		ApplySpellRES("EJRDC%ejrd_j%",Myself)
		DisplayStringHead(Myself,%ejp_constr%)
END~~~~~
	END
	APPEND_OUTER ~weidu_external/npc-bodies/EJPCS%k%.baf~ ~~~~~
IF
	Global("EJRDqP%k%","GLOBAL",1)
	InParty(Myself)
	!StateCheck(Myself,STATE_DEAD)
THEN
	RESPONSE #100
		SetGlobal("EJRDqP%k%","GLOBAL",0)
END~~~~~
	OUTER_FOR (ejrd_j = 1; ejrd_j <= 5; ++ejrd_j) BEGIN
		APPEND_OUTER ~weidu_external/npc-bodies/EJPCS%k%.baf~ ~~~~~
IF
	Global("EJRDsP%k%_%ejrd_j%","GLOBAL",1)
	GlobalTimerExpired("EJRDtP%k%_%ejrd_j%","GLOBAL")
	!StateCheck(Myself,STATE_DEAD)
THEN
	RESPONSE #100
		SetGlobal("EJRDsP%k%_%ejrd_j%","GLOBAL",0)
		ApplySpellRES("EJRDR%ejrd_j%",Myself)
END~~~~~
	END
	COMPILE ~weidu_external/npc-bodies/EJPCS%k%.baf~
END

// -----------------------------------------------------------------------------
// "Not a joinable NPC" check: !Name(...) for every NPC death variable.
// -----------------------------------------------------------------------------
OUTER_SPRINT ejp_chain ~~
COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
	COUNT_2DA_ROWS 9 ejp_rows
OUTER_FOR (r = 1; r < ejp_rows; ++r) BEGIN
	COPY ~weidu_external/npc-bodies/NPCbods.2da~ ~weidu_external/npc-bodies/NPCbods.2da~
		READ_2DA_ENTRY r 1 9 ejp_dv
	ACTION_TO_UPPER ejp_dv
	ACTION_IF NOT VARIABLE_IS_SET $EJP_DV_SEEN(~%ejp_dv%~) BEGIN
		OUTER_SET $EJP_DV_SEEN(~%ejp_dv%~) = 1
		OUTER_SPRINT ejp_chain ~~~~~%ejp_chain%
	!Name("%ejp_dv%",PLAYERSLOT)~~~~~
	END
END

// -----------------------------------------------------------------------------
// Global script (appended to baldur/bdbaldur/baldur25, like Component 100).
// -----------------------------------------------------------------------------
COPY ~npc-inline/ejp_empty.baf~ ~weidu_external/npc-bodies/ejpc.baf~
APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	Global("EJPCnext","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("EJPCnext","GLOBAL",1)
END~~~~~

// Registration of the slot chosen by the scan blocks below.
OUTER_FOR (N = 2; N <= 6; ++N) BEGIN
	OUTER_SET N10 = N + 10
	OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
		APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	Global("EJPCpend","GLOBAL",%N%)
	Global("EJPCnext","GLOBAL",%k%)
	InParty(Player%N%)
	!CheckSpellState(Player%N%,%ejp_any%)
THEN
	RESPONSE #100
		SetGlobal("EJPCpend","GLOBAL",%N10%)
		SetGlobalTimer("EJPCwait","GLOBAL",12)
		ApplySpellRES("EJPCR%k%",Player%N%)
		ActionOverride(Player%N%,ChangeAIScript("EJPCS%k%",OVERRIDE))
END~~~~~
	END
END
APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	GlobalGT("EJPCpend","GLOBAL",0)
	GlobalLT("EJPCpend","GLOBAL",10)
THEN
	RESPONSE #100
		SetGlobal("EJPCpend","GLOBAL",0)
END
IF
	GlobalGT("EJPCpend","GLOBAL",10)
	GlobalTimerExpired("EJPCwait","GLOBAL")
THEN
	RESPONSE #100
		SetGlobal("EJPCpend","GLOBAL",0)
END~~~~~

OUTER_SET ejp_max1 = ejp_max + 1
OUTER_FOR (N = 2; N <= 6; ++N) BEGIN
	OUTER_PATCH_SAVE ejp_chain_n ~%ejp_chain%~ BEGIN
		REPLACE_TEXTUALLY ~PLAYERSLOT~ ~Player%N%~
	END
	APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	Global("EJPCpend","GLOBAL",0)
	GlobalLT("EJPCnext","GLOBAL",%ejp_max1%)
	GlobalGT("EJPCnext","GLOBAL",0)
	InParty(Player%N%)
	!CheckSpellState(Player%N%,%ejp_any%)%ejp_chain_n%
THEN
	RESPONSE #100
		SetGlobal("EJPCpend","GLOBAL",%N%)
END~~~~~
END

// Temple hand-over (priest reply sets EJPChand = N). Confirmed working.
OUTER_FOR (N = 2; N <= 6; ++N) BEGIN
	OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
		OUTER_SET SS = $EJP_SS(~%k%~)
		OUTER_SET care = $EJP_CARE(~%k%~)
		APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	Global("EJPChand","GLOBAL",%N%)
	CheckSpellState(Player%N%,%SS%)
THEN
	RESPONSE #100
		SetGlobal("EJPCcare%k%","GLOBAL",0)
		AddGlobals("EJPCcare%k%","EJPChandP")
		SetGlobal("EJPCst%k%","GLOBAL",4)
		SetGlobal("EJPChand","GLOBAL",0)
		SetGlobal("EJPCslot%N%","GLOBAL",0)
		DisplayStringHead(Player%N%,%care%)
		ActionOverride(Player%N%,LeaveParty())
END~~~~~
	END
END
APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	GlobalGT("EJPChand","GLOBAL",0)
	GlobalTimerExpired("EJPChandT","GLOBAL")
THEN
	RESPONSE #100
		SetGlobal("EJPChand","GLOBAL",0)
END~~~~~

// Slot flags (which number is Player<N>), and noticing a registered
// character is no longer in the party (their own script cannot, once dead
// outside the party).
OUTER_FOR (N = 2; N <= 6; ++N) BEGIN
	OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
		OUTER_SET SS = $EJP_SS(~%k%~)
		APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	CheckSpellState(Player%N%,%SS%)
	!Global("EJPCslot%N%","GLOBAL",%k%)
THEN
	RESPONSE #100
		SetGlobal("EJPCslot%N%","GLOBAL",%k%)
END
IF
	CheckSpellState(Player%N%,%SS%)
	StateCheck(Player%N%,STATE_DEAD)
	Global("EJPCarm%k%","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("EJPCarm%k%","GLOBAL",1)
		SetGlobalTimer("EJPCdipT%k%","GLOBAL",6)
END
IF
	CheckSpellState(Player%N%,%SS%)
	!StateCheck(Player%N%,STATE_DEAD)
	Global("EJPCarm%k%","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("EJPCarm%k%","GLOBAL",0)
END~~~~~
	END
	APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	GlobalGT("EJPCslot%N%","GLOBAL",0)
	!InPartyAllowDead(Player%N%)
THEN
	RESPONSE #100
		SetGlobal("EJPCslot%N%","GLOBAL",0)
END
IF
	GlobalGT("EJPCslot%N%","GLOBAL",0)
	!CheckSpellState(Player%N%,%ejp_any%)
THEN
	RESPONSE #100
		SetGlobal("EJPCslot%N%","GLOBAL",0)
END~~~~~
END
OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
	OUTER_SET SS = $EJP_SS(~%k%~)
	APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	OR(2)
		Global("EJPCst%k%","GLOBAL",1)
		Global("EJPCst%k%","GLOBAL",2)
	!Global("EJPCbusy%k%","GLOBAL",1)
	!CheckSpellState(Player2,%SS%)
	!CheckSpellState(Player3,%SS%)
	!CheckSpellState(Player4,%SS%)
	!CheckSpellState(Player5,%SS%)
	!CheckSpellState(Player6,%SS%)
THEN
	RESPONSE #100
		SetGlobal("EJPCst%k%","GLOBAL",3)
END~~~~~
END

// Timeouts: nothing happened (body not in this area) / revival did not take.
OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
	APPEND_OUTER ~weidu_external/npc-bodies/ejpc.baf~ ~~~~~
IF
	GlobalGT("EJPCrev%k%","GLOBAL",0)
	!Global("EJPCbusy%k%","GLOBAL",1)
	GlobalTimerExpired("EJPCto%k%","GLOBAL")
THEN
	RESPONSE #100
		GivePartyGoldGlobal("EJPCpaid%k%","GLOBAL")
		SetGlobal("EJPCpaid%k%","GLOBAL",0)
		SetGlobal("EJPCrev%k%","GLOBAL",0)
		DisplayStringHead(Player1,%ejp_fail_str%)
END
IF
	Global("EJPCbusy%k%","GLOBAL",1)
	GlobalTimerExpired("EJPCto%k%","GLOBAL")
THEN
	RESPONSE #100
		GivePartyGoldGlobal("EJPCpaid%k%","GLOBAL")
		SetGlobal("EJPCpaid%k%","GLOBAL",0)
		SetGlobal("EJPCrev%k%","GLOBAL",0)
		SetGlobal("EJPCbusy%k%","GLOBAL",0)
		DisplayStringHead(Player1,%ejp_spellfail_str%)
END
IF
	Global("EJPCcol%k%","GLOBAL",1)
	GlobalTimerExpired("EJPCcolT%k%","GLOBAL")
THEN
	RESPONSE #100
		SetGlobal("EJPCcol%k%","GLOBAL",0)
		DisplayStringHead(Player1,%ejp_nocol_str%)
END~~~~~
END

ACTION_FOR_EACH ejp_baldur IN ~baldur~ ~bdbaldur~ ~baldur25~ BEGIN
	ACTION_IF (FILE_EXISTS_IN_GAME ~%ejp_baldur%.bcs~) BEGIN
		EXTEND_BOTTOM ~%ejp_baldur%.bcs~ ~weidu_external/npc-bodies/ejpc.baf~
	END
END

// -----------------------------------------------------------------------------
// Priest dialogue: one .d per detected priest (list written by Component 600).
// -----------------------------------------------------------------------------
ACTION_IF FILE_EXISTS ~weidu_external/npc-bodies/ejt_priest_areas.txt~ BEGIN
	COPY ~weidu_external/npc-bodies/ejt_priest_areas.txt~ ~weidu_external/npc-bodies/ejt_priest_areas.txt~
		COUNT_2DA_ROWS 2 ejp_prows
	OUTER_FOR (p = 1; p < ejp_prows; ++p) BEGIN
		COPY ~weidu_external/npc-bodies/ejt_priest_areas.txt~ ~weidu_external/npc-bodies/ejt_priest_areas.txt~
			READ_2DA_ENTRY p 0 2 ejp_priest
		ACTION_IF FILE_EXISTS_IN_GAME ~%ejp_priest%.dlg~ BEGIN
			COPY ~npc-inline/ejp_empty.baf~ ~weidu_external/npc-bodies/ejpcpr_%ejp_priest%.d~
			APPEND_OUTER ~weidu_external/npc-bodies/ejpcpr_%ejp_priest%.d~ ~~~~~EXTEND_BOTTOM ~%ejp_priest%~ 0~~~~~
			OUTER_FOR (N = 2; N <= 6; ++N) BEGIN
				OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
					APPEND_OUTER ~weidu_external/npc-bodies/ejpcpr_%ejp_priest%.d~ ~~~~~
	IF ~Global("EJPCslot%N%","GLOBAL",%k%)
	    StateCheck(Player%N%,STATE_DEAD)
	    Global("EJPChand","GLOBAL",0)~ THEN REPLY ~Fallen companion #%k% has died. Keep their body here in your temple's care until I return for them.~
		DO ~SetGlobal("EJPChandP","GLOBAL",%p%)
		   SetGlobalTimer("EJPChandT","GLOBAL",12)
		   SetGlobal("EJPChand","GLOBAL",%N%)~
		EXIT~~~~~
				END
			END
			OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
				APPEND_OUTER ~weidu_external/npc-bodies/ejpcpr_%ejp_priest%.d~ ~~~~~
	IF ~Global("EJPCst%k%","GLOBAL",3)
	    Global("EJPCcol%k%","GLOBAL",0)
	    Global("EJPCrev%k%","GLOBAL",0)
	    OR(2)
	        Global("EJPCdead%k%","GLOBAL",1)
	        Global("EJPCchunk%k%","GLOBAL",1)~ THEN REPLY ~I left the body of fallen companion #%k% somewhere nearby. Please collect it and keep it here in your temple's care until I return for them.~
		DO ~SetGlobal("EJPChandP","GLOBAL",%p%)
		   SetGlobalTimer("EJPCcolT%k%","GLOBAL",30)
		   SetGlobal("EJPCcol%k%","GLOBAL",1)~
		EXIT
	IF ~Global("EJPCst%k%","GLOBAL",4)
	    Global("EJPCcare%k%","GLOBAL",%p%)
	    Global("EJPCrev%k%","GLOBAL",0)
	    Global("EJPCchunk%k%","GLOBAL",0)
	    PartyHasItem("EJPB%k%")
	    PartyGoldGT(%ejp_raise_m1%)~ THEN REPLY ~Fallen companion #%k% rests in your care, and I still have their body. Raise them from death. (Raise Dead, %ejp_raise_cost% gold)~
		DO ~TakePartyGold(%ejp_raise_cost%)
		   SetGlobal("EJPCpaid%k%","GLOBAL",%ejp_raise_cost%)
		   SetGlobalTimer("EJPCto%k%","GLOBAL",30)
		   SetGlobal("EJPCrev%k%","GLOBAL",1)~
		EXIT
	IF ~Global("EJPCst%k%","GLOBAL",4)
	    Global("EJPCcare%k%","GLOBAL",%p%)
	    Global("EJPCrev%k%","GLOBAL",0)
	    PartyGoldGT(%ejp_res_m1%)~ THEN REPLY ~Fallen companion #%k% rests in your care. Return them to life with a Resurrection. (%ejp_res_cost% gold)~
		DO ~TakePartyGold(%ejp_res_cost%)
		   SetGlobal("EJPCpaid%k%","GLOBAL",%ejp_res_cost%)
		   SetGlobalTimer("EJPCto%k%","GLOBAL",30)
		   SetGlobal("EJPCrev%k%","GLOBAL",2)~
		EXIT
	IF ~Global("EJPCst%k%","GLOBAL",4)
	    Global("EJPCcare%k%","GLOBAL",%p%)
	    Global("EJPCrev%k%","GLOBAL",0)
	    !PartyGoldGT(%ejp_res_m1%)~ THEN REPLY ~Fallen companion #%k% rests in your care, but I cannot yet afford their Resurrection. (Resurrection costs %ejp_res_cost% gold)~
		EXIT~~~~~
			END
			APPEND_OUTER ~weidu_external/npc-bodies/ejpcpr_%ejp_priest%.d~ ~~~~~END~~~~~
			COMPILE ~weidu_external/npc-bodies/ejpcpr_%ejp_priest%.d~
		END
	END
END

// -----------------------------------------------------------------------------
// Wish genie: free revival of a dismissed registered body lying in this area.
// -----------------------------------------------------------------------------
ACTION_IF FILE_EXISTS_IN_GAME ~WISH01.cre~ BEGIN
	COPY_EXISTING ~WISH01.cre~ ~override~
		READ_ASCII 0x2cc ejp_w1
		SPRINT ejp_w1s ~%ejp_w1%~
		INNER_ACTION BEGIN
			OUTER_SPRINT ejp_wishdlg1 ~%ejp_w1s%~
		END
	BUT_ONLY
	OUTER_SPRINT ejp_wishdlg2 ~%ejp_wishdlg1%~
	ACTION_IF FILE_EXISTS_IN_GAME ~WISH02.cre~ BEGIN
		COPY_EXISTING ~WISH02.cre~ ~override~
			READ_ASCII 0x2cc ejp_w2
			SPRINT ejp_w2s ~%ejp_w2%~
			INNER_ACTION BEGIN
				OUTER_SPRINT ejp_wishdlg2 ~%ejp_w2s%~
			END
		BUT_ONLY
	END
	ACTION_FOR_EACH ejp_wd IN ~1~ ~2~ BEGIN
		ACTION_IF (~%ejp_wd%~ STRING_EQUAL ~1~) BEGIN
			OUTER_SPRINT ejp_dlg ~%ejp_wishdlg1%~
		END ELSE BEGIN
			OUTER_SPRINT ejp_dlg ~%ejp_wishdlg2%~
		END
		ACTION_IF ((~%ejp_wd%~ STRING_EQUAL ~1~) OR NOT (~%ejp_wishdlg1%~ STRING_EQUAL_CASE ~%ejp_wishdlg2%~)) BEGIN
			ACTION_IF FILE_EXISTS_IN_GAME ~%ejp_dlg%.dlg~ BEGIN
				COPY ~npc-inline/ejp_empty.baf~ ~weidu_external/npc-bodies/ejpcgenie%ejp_wd%.d~
				APPEND_OUTER ~weidu_external/npc-bodies/ejpcgenie%ejp_wd%.d~ ~~~~~EXTEND_BOTTOM ~%ejp_dlg%~ 0~~~~~
				OUTER_FOR (k = 1; k <= ejp_max; ++k) BEGIN
					APPEND_OUTER ~weidu_external/npc-bodies/ejpcgenie%ejp_wd%.d~ ~~~~~
	IF ~GlobalGT("EJPCst%k%","GLOBAL",2)
	    Global("EJPCrev%k%","GLOBAL",0)
	    OR(2)
	        Global("EJPCdead%k%","GLOBAL",1)
	        Global("EJPCchunk%k%","GLOBAL",1)~ THEN REPLY ~Restore fallen companion #%k% to life, if their body lies near. (Free -- a wish supersedes even death itself)~
		DO ~SetGlobal("EJPCpaid%k%","GLOBAL",0)
		   SetGlobalTimer("EJPCto%k%","GLOBAL",30)
		   SetGlobal("EJPCrev%k%","GLOBAL",2)
		   DestroySelf()~
		EXIT~~~~~
				END
				APPEND_OUTER ~weidu_external/npc-bodies/ejpcgenie%ejp_wd%.d~ ~~~~~END~~~~~
				COMPILE ~weidu_external/npc-bodies/ejpcgenie%ejp_wd%.d~
			END
		END
	END
END
